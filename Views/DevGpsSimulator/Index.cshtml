@{
    ViewData["Title"] = "GPS Simulator";
    Layout = "_DashboardLayout";
    var activeTrips = ViewBag.ActiveTrips as List<ERPDemo.Models.Trip> ?? new();
}

<div class="rt-page">

    <div class="rt-head">
        <div>
            <h1>🧪 GPS Simulator</h1>
            <p>Dev-only — fake GPS data inject karo bina device ke</p>
        </div>
        <span class="rt-tag rt-coral">DEV ONLY</span>
    </div>

    <div class="rt-alert rt-alert-error mb-3">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <strong>Warning:</strong> Sirf development mode mein available hai.
    </div>

    <section class="rt-window">
        <div class="rt-titlebar">
            <span><i class="bi bi-signpost-split me-2"></i>Active / Planned Trips</span>
        </div>
        <div class="rt-scroll">
            <table class="rt-table" style="width:100%;">
                <thead>
                    <tr>
                        <th>Trip #</th>
                        <th>Vehicle</th>
                        <th>Driver</th>
                        <th>Route</th>
                        <th>Status</th>
                        <th style="text-align:center;">Simulate</th>
                    </tr>
                </thead>
                <tbody>
                @if (activeTrips.Any())
                {
                    foreach (var t in activeTrips)
                    {
                        <tr>
                            <td><strong>@t.TripNumber</strong></td>
                            <td>@(t.Vehicle?.RegistrationNumber ?? "—")</td>
                            <td>@(t.Driver?.FullName ?? "—")</td>
                            <td>@(t.OriginCity ?? "—") → @(t.DestinationCity ?? "—")</td>
                            <td>
                                <span class="rt-tag @(t.Status == "InProgress" ? "rt-amber" : "rt-sky")">
                                    @t.Status
                                </span>
                            </td>
                            <td style="text-align:center;">
                                <a asp-action="SimulateTripForm"
                                   asp-route-vehicleId="@t.VehicleId"
                                   asp-route-tripId="@t.TripId"
                                   class="rt-btn rt-btn-sm rt-btn-primary">
                                    <i class="bi bi-play-fill me-1"></i> Simulate
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
                            Koi active/planned trip nahi mila.
                            <a asp-controller="Trips" asp-action="Create" class="d-block mt-2">
                                Pehle ek trip banao →
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

</div>