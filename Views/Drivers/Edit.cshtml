@model ERPDemo.ViewModels.DriverFormViewModel
@{
    ViewData["Title"] = "Edit Driver";
    Layout = "_DashboardLayout";
}

<div class="rt-page">

    <div class="rt-head">
        <div>
            <h1>Edit Driver</h1>
            <p>Update driver details</p>
        </div>
        <a asp-action="Index" class="rt-btn">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="DriverId" />
        <div asp-validation-summary="ModelOnly" class="rt-alert rt-alert-error mb-3"></div>

        <section class="rt-window">
            <div class="rt-titlebar">
                <span><i class="bi bi-person-badge me-2"></i>Driver Details</span>
            </div>
            <div class="p-3 row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="rt-label"></label>
                    <input asp-for="FullName" class="rt-input" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="rt-label"></label>
                    <input asp-for="PhoneNumber" class="rt-input" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LicenseNumber" class="rt-label"></label>
                    <input asp-for="LicenseNumber" class="rt-input" />
                    <span asp-validation-for="LicenseNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LicenseExpiry" class="rt-label"></label>
                    <input asp-for="LicenseExpiry" class="rt-input" type="date" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Status" class="rt-label"></label>
                    <select asp-for="Status" class="rt-input">
                        @foreach (var s in Model.StatusOptions)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="DepotLocation" class="rt-label"></label>
                    <select asp-for="DepotLocation" class="rt-input">
                        <option value="">-- Select Depot --</option>
                        @foreach (var p in Model.HaryanaDepots)
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </div>
            </div>
        </section>

        <section class="rt-window mt-3">
            <div class="rt-titlebar">
                <span><i class="bi bi-link me-2"></i>Link Vehicle & User Account</span>
            </div>
            <div class="p-3 row g-3">
                <div class="col-md-6">
                    <label asp-for="VehicleId" class="rt-label"></label>
                    <select asp-for="VehicleId" class="rt-input">
                        <option value="">-- Not assigned --</option>
                        @foreach (var v in Model.AvailableVehicles)
                        {
                            <option value="@v.VehicleId">@v.Label</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="UserId" class="rt-label"></label>
                    <select asp-for="UserId" class="rt-input">
                        <option value="">-- No login account --</option>
                        @foreach (var u in Model.AvailableUsers)
                        {
                            <option value="@u.UserId">@u.Label</option>
                        }
                    </select>
                </div>
            </div>
        </section>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="rt-btn rt-btn-primary">
                <i class="bi bi-check-circle me-1"></i> Update Driver
            </button>
            <a asp-action="Index" class="rt-btn">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}