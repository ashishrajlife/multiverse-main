@model ERPDemo.Models.Driver
@{
    ViewData["Title"] = "Driver — " + Model.FullName;
    Layout = "_DashboardLayout";
    var today = DateTime.Today;
    var in30 = today.AddDays(30);
    var recentTrips = ViewBag.RecentTrips as List<ERPDemo.Models.Trip> ?? new();

    var totalTrips    = (int)(ViewBag.TotalTrips ?? 0);
    var totalDistKm   = (decimal)(ViewBag.TotalDistanceKm ?? 0m);
    var totalRevenue  = (decimal)(ViewBag.TotalRevenue ?? 0m);
    var totalIdleMin  = (int)(ViewBag.TotalIdleMin ?? 0);
    var maxSpeedKmph  = (int)(ViewBag.MaxSpeedKmph ?? 0);

    string DocTag(DateTime? dt)
    {
        if (!dt.HasValue) return "rt-nodot";
        if (dt.Value < today) return "rt-coral";
        if (dt.Value <= in30) return "rt-amber";
        return "rt-green";
    }
}

<div class="rt-page">

    <div class="rt-head">
        <div>
            <h1>@Model.FullName</h1>
            <p>Driver profile · @(Model.DepotLocation ?? "—")</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.DriverId" class="rt-btn rt-btn-primary">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
            <a asp-action="Index" class="rt-btn">Back</a>
        </div>
    </div>

    <div class="rt-stats">
        <div class="rt-stat rt-sky">
            <span class="rt-stat-icon"><i class="bi bi-telephone"></i></span>
            <div>
                <span class="rt-stat-label">Phone</span>
                <span class="rt-stat-value" style="font-size:16px;">@(Model.PhoneNumber ?? "—")</span>
            </div>
        </div>
        <div class="rt-stat rt-green">
            <span class="rt-stat-icon"><i class="bi bi-card-text"></i></span>
            <div>
                <span class="rt-stat-label">License</span>
                <span class="rt-stat-value" style="font-size:15px;">@(Model.LicenseNumber ?? "—")</span>
            </div>
        </div>
        <div class="rt-stat rt-amber">
            <span class="rt-stat-icon"><i class="bi bi-calendar-check"></i></span>
            <div>
                <span class="rt-stat-label">License Expiry</span>
                <span class="rt-stat-value" style="font-size:15px;">
                    @(Model.LicenseExpiry?.ToString("MMM dd, yyyy") ?? "—")
                </span>
            </div>
        </div>
        <div class="rt-stat rt-violet">
            <span class="rt-stat-icon"><i class="bi bi-activity"></i></span>
            <div>
                <span class="rt-stat-label">Status</span>
                <span class="rt-stat-value" style="font-size:16px;">@Model.Status</span>
            </div>
        </div>
    </div>

    <!-- GPS Performance Stats -->
    <div class="rt-section-label"><i class="bi bi-geo-alt me-2"></i>GPS Performance Metrics</div>
    <div class="rt-stats">
        <div class="rt-stat rt-green">
            <span class="rt-stat-icon"><i class="bi bi-check2-square"></i></span>
            <div>
                <span class="rt-stat-label">Total Trips</span>
                <span class="rt-stat-value">@totalTrips</span>
            </div>
        </div>
        <div class="rt-stat rt-sky">
            <span class="rt-stat-icon"><i class="bi bi-speedometer2"></i></span>
            <div>
                <span class="rt-stat-label">Total Distance</span>
                <span class="rt-stat-value">@totalDistKm.ToString("N0") <small style="font-size:12px;">km</small></span>
            </div>
        </div>
        <div class="rt-stat rt-amber">
            <span class="rt-stat-icon"><i class="bi bi-cash-coin"></i></span>
            <div>
                <span class="rt-stat-label">Total Revenue</span>
                <span class="rt-stat-value">₹@totalRevenue.ToString("N0")</span>
            </div>
        </div>
        <div class="rt-stat rt-coral">
            <span class="rt-stat-icon"><i class="bi bi-hourglass-split"></i></span>
            <div>
                <span class="rt-stat-label">Idle Time</span>
                <span class="rt-stat-value">@(totalIdleMin / 60) <small style="font-size:12px;">hr</small> @(totalIdleMin % 60) <small style="font-size:12px;">min</small></span>
            </div>
        </div>
        <div class="rt-stat rt-violet">
            <span class="rt-stat-icon"><i class="bi bi-lightning-charge"></i></span>
            <div>
                <span class="rt-stat-label">Max Speed</span>
                <span class="rt-stat-value">@maxSpeedKmph <small style="font-size:12px;">km/h</small></span>
            </div>
        </div>
    </div>

    <!-- Assignments -->
    <section class="rt-window mt-3">
        <div class="rt-titlebar">
            <span><i class="bi bi-link me-2"></i>Assignments</span>
        </div>
        <div class="p-3 row g-3">
            <div class="col-md-6">
                <div class="rt-label">Assigned Vehicle</div>
                @if (Model.Vehicle != null)
                {
                    <a asp-controller="Vehicles" asp-action="Details" asp-route-id="@Model.VehicleId"
                       class="rt-tag rt-sky">
                        <i class="bi bi-truck-front me-1"></i>@Model.Vehicle.RegistrationNumber
                    </a>
                }
                else
                {
                    <span class="text-muted">Not assigned</span>
                }
            </div>
            <div class="col-md-6">
                <div class="rt-label">Linked User Account</div>
                @if (Model.User != null)
                {
                    <span class="rt-tag rt-green">
                        <i class="bi bi-person me-1"></i>@(Model.User.FullName ?? Model.User.Username)
                    </span>
                }
                else
                {
                    <span class="text-muted">No login account linked</span>
                }
            </div>
        </div>
    </section>

    <!-- Recent Trips -->
    <section class="rt-window mt-3">
        <div class="rt-titlebar">
            <span><i class="bi bi-signpost-split me-2"></i>Recent Trips</span>
        </div>
        <div class="rt-scroll">
            <table class="rt-table">
                <thead>
                    <tr>
                        <th>Trip #</th>
                        <th>Vehicle</th>
                        <th>Route</th>
                        <th>Distance</th>
                        <th>Status</th>
                        <th class="text-end">Revenue</th>
                    </tr>
                </thead>
                <tbody>
                @if (recentTrips.Any())
                {
                    foreach (var t in recentTrips)
                    {
                        <tr>
                            <td><strong>@t.TripNumber</strong></td>
                            <td>@(t.Vehicle?.RegistrationNumber ?? "—")</td>
                            <td>@(t.OriginCity ?? "—") → @(t.DestinationCity ?? "—")</td>
                            <td>@(t.GpsDistanceKm.HasValue ? t.GpsDistanceKm.Value.ToString("N0") + " km" : "—")</td>
                            <td><span class="rt-tag rt-nodot">@t.Status</span></td>
                            <td class="text-end">₹@((t.Revenue ?? 0).ToString("N0"))</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No trips yet.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </section>

</div>