@model List<ERPDemo.Models.Vehicle>
@{
    ViewData["Title"] = "Vehicles";
    Layout = "_DashboardLayout";
    var today = DateTime.Today;
    var in30 = today.AddDays(30);
}

<div class="rt-page">

    <div class="rt-head">
        <div>
            <h1>Vehicles</h1>
            <p>@Model.Count vehicle(s) registered — Haryana fleet</p>
        </div>
        <a asp-action="Create" class="rt-btn rt-btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Add Vehicle
        </a>
    </div>

    <!-- Filters -->
    <form method="get" class="rt-filter-bar">
        <input type="text" name="search" value="@ViewBag.Search"
               placeholder="Search by reg no / make / model..."
               class="rt-input" style="max-width:340px;" />
        <select name="status" class="rt-input" style="max-width:160px;">
            @foreach (var s in (List<string>)ViewBag.StatusOptions)
            {
                <option value="@s" selected="@(s == ViewBag.Status)">@s</option>
            }
        </select>
        <button type="submit" class="rt-btn rt-btn-primary">
            <i class="bi bi-search me-1"></i> Filter
        </button>
        @if (!string.IsNullOrEmpty(ViewBag.Search as string) || (ViewBag.Status as string) != "All")
        {
            <a asp-action="Index" class="rt-btn">Clear</a>
        }
    </form>

    <!-- Table -->
    <section class="rt-window mt-3">
        <div class="rt-scroll">
            <table class="rt-table rt-table-vehicles" style="width: 100%; table-layout: fixed;">
                <colgroup>
                    <col style="width: 14%;" />   @* Registration *@
                    <col style="width: 8%;" />    @* Type *@
                    <col style="width: 16%;" />   @* Make/Model *@
                    <col style="width: 10%;" />   @* Status *@
                    <col style="width: 11%;" />   @* Insurance *@
                    <col style="width: 11%;" />   @* Fitness *@
                    <col style="width: 10%;" />   @* Permit *@
                    <col style="width: 20%;" />   @* Actions *@
                </colgroup>
                <thead>
                    <tr>
                        <th>Registration</th>
                        <th>Type</th>
                        <th>Make / Model</th>
                        <th>Status</th>
                        <th>Insurance</th>
                        <th>Fitness</th>
                        <th>Permit</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Any())
                {
                    foreach (var v in Model)
                    {
                        var statusClass = v.Status switch
                        {
                            "Active"      => "rt-green",
                            "Maintenance" => "rt-amber",
                            "Idle"        => "rt-sky",
                            _             => "rt-coral"
                        };

                        string DocTag(DateTime? dt)
                        {
                            if (!dt.HasValue) return "rt-nodot";
                            if (dt.Value < today) return "rt-coral";
                            if (dt.Value <= in30) return "rt-amber";
                            return "rt-green";
                        }

                        <tr>
                            <td><strong>@v.RegistrationNumber</strong></td>
                            <td>@v.VehicleType</td>
                            <td>@(v.Make ?? "—") @(v.Model != null ? "· " + v.Model : "")</td>
                            <td><span class="rt-tag @statusClass">@v.Status</span></td>
                            <td>
                                <span class="rt-tag @DocTag(v.InsuranceExpiry)">
                                    @(v.InsuranceExpiry?.ToString("MMM dd, yy") ?? "—")
                                </span>
                            </td>
                            <td>
                                <span class="rt-tag @DocTag(v.FitnessExpiry)">
                                    @(v.FitnessExpiry?.ToString("MMM dd, yy") ?? "—")
                                </span>
                            </td>
                            <td>
                                <span class="rt-tag @DocTag(v.PermitExpiry)">
                                    @(v.PermitExpiry?.ToString("MMM dd, yy") ?? "—")
                                </span>
                            </td>
                            <td class="rt-actions-cell">
                                <div class="rt-action-group">

                                    @* Toggle Active/Idle *@
                                    @if (User.IsInRole("Admin"))
                                    {
                                        var isRetired = v.Status == "Retired";
                                        var isActive  = v.Status == "Active";

                                        <form asp-action="ToggleActive" asp-route-id="@v.VehicleId" method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('@(isActive ? "Deactivate" : "Activate") @v.RegistrationNumber?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="rt-btn rt-btn-sm @(isActive ? "rt-btn-warn" : "rt-btn-success")"
                                                    title="@(isRetired ? "Retired vehicle cannot be reactivated" : (isActive ? "Deactivate" : "Activate"))"
                                                    @(isRetired ? "disabled" : "")>
                                                <i class="bi @(isActive ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                            </button>
                                        </form>
                                    }

                                    @* View *@
                                    <a asp-action="Details" asp-route-id="@v.VehicleId"
                                       class="rt-btn rt-btn-sm" title="View">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    @* Edit *@
                                    <a asp-action="Edit" asp-route-id="@v.VehicleId"
                                       class="rt-btn rt-btn-sm" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    @* Delete *@
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <form asp-action="Delete" asp-route-id="@v.VehicleId" method="post"
                                              onsubmit="return confirm('Delete @v.RegistrationNumber?');" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="rt-btn rt-btn-sm rt-btn-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-5">
                            <i class="bi bi-truck fs-3 d-block mb-2"></i>
                            Koi vehicle nahi mila.
                            <a asp-action="Create" class="d-block mt-2">Add your first vehicle →</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

</div>