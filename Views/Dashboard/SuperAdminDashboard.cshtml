@{
    ViewData["Title"] = "Super Admin Dashboard";
    Layout = "_DashboardLayout";

    var recentOrgs = ViewBag.RecentOrganizations as List<ERPDemo.Models.Organization> ?? new();
    var monthLabels = ViewBag.MonthLabels as List<string> ?? new();
    var monthCounts = ViewBag.MonthCounts as List<int> ?? new();
}

@section Styles {
<style>
    /* =====================================================
       SUPER ADMIN DASHBOARD
    ===================================================== */

    .report-card {
        padding: 20px;
        background: var(--card);
        border: 1px solid var(--card-border);
        border-radius: 16px;
        box-shadow: var(--shadow-sm);
        height: 100%;
    }

    .report-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 16px;
    }

    .report-card-header h3 {
        margin: 0;
        font-size: 15px;
        font-weight: 700;
        color: var(--ink);
    }

    .report-card-header small {
        font-size: 12px;
        color: var(--ink-mute);
    }

    .chart-wrap {
        position: relative;
        height: 320px;
    }

    /* ---------- Recent orgs list ---------- */
    .mini-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .mini-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px dashed #edf0f4;
    }

    .mini-item:last-child { border-bottom: none; }

    .mini-item .avatar {
        flex: 0 0 auto;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        font-size: 14px;
        font-weight: 700;
    }

    .mini-item-body {
        flex: 1;
        min-width: 0;
        line-height: 1.3;
    }

    .mini-item-title {
        display: block;
        font-size: 13.5px;
        font-weight: 600;
        color: var(--ink);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mini-item-sub {
        display: block;
        font-size: 12px;
        color: var(--ink-mute);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mini-item-meta {
        flex: 0 0 auto;
        text-align: right;
        font-size: 11.5px;
        color: var(--ink-mute);
        line-height: 1.4;
    }

    @@media (max-width: 575.98px) {
        .chart-wrap { height: 240px; }
    }
</style>
}

<!-- ====================== PAGE HEADER ====================== -->
<div class="page-header">
    <div>
        <h1>Control Center</h1>
        <p>Complete authority over organizations, users, roles, and the platform</p>
        <div class="page-accent"></div>
    </div>
</div>

<!-- ====================== GROWTH + RECENT ORGS ====================== -->
<div class="row g-3 g-lg-4">
    <!-- Organization Growth Line Chart -->
    <div class="col-lg-7">
        <div class="report-card">
            <div class="report-card-header">
                <h3><i class="bi bi-graph-up-arrow me-2 text-primary"></i>Organization Growth</h3>
                <small>Last 6 months</small>
            </div>
            <div class="chart-wrap">
                <canvas id="orgGrowthChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Recently Added Organizations -->
    <div class="col-lg-5">
        <div class="report-card">
            <div class="report-card-header">
                <h3><i class="bi bi-building-add me-2 text-primary"></i>Recently Added Organizations</h3>
                <a asp-controller="Organization" asp-action="Index" class="panel-link">
                    View all <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            @if (!recentOrgs.Any())
            {
                <div class="empty-state" style="padding: 30px 10px;">
                    <i class="bi bi-building"></i>
                    <strong>No organizations yet</strong>
                    <span>New companies will appear here</span>
                </div>
            }
            else
            {
                <ul class="mini-list">
                    @foreach (var org in recentOrgs)
                    {
                        var planTone = org.Plan switch
                        {
                            "Enterprise" => "coral",
                            "Pro" => "amber",
                            _ => "sky"
                        };
                        var initials = !string.IsNullOrEmpty(org.Name)
                            ? org.Name.Substring(0, 1).ToUpper()
                            : "?";

                        <li class="mini-item">
                            <span class="avatar tone-violet">@initials</span>
                            <div class="mini-item-body">
                                <span class="mini-item-title">@org.Name</span>
                                <span class="mini-item-sub">
                                    @org.Code • @(org.City ?? "—")@(org.Country != null ? ", " + org.Country : "")
                                </span>
                            </div>
                            <div class="mini-item-meta">
                                <span class="pill tone-@planTone" style="font-size:11px;">@org.Plan</span>
                                <br />
                                <small>@org.CreatedAt.ToString("MMM dd, yyyy")</small>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    (function () {
        const violet = '#7c5cff';

        // ---------- Organization Growth (LINE CHART) ----------
        const orgGrowthEl = document.getElementById('orgGrowthChart');
        if (orgGrowthEl) {
            const ctx = orgGrowthEl.getContext('2d');

            const gradient = ctx.createLinearGradient(0, 0, 0, 320);
            gradient.addColorStop(0, 'rgba(124, 92, 255, 0.35)');
            gradient.addColorStop(1, 'rgba(124, 92, 255, 0.02)');

            new Chart(orgGrowthEl, {
                type: 'line',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(monthLabels)),
                    datasets: [{
                        label: 'Organizations',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(monthCounts)),
                        borderColor: violet,
                        backgroundColor: gradient,
                        borderWidth: 3,
                        fill: true,
                        tension: 0.35,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: violet,
                        pointBorderWidth: 3,
                        pointRadius: 5,
                        pointHoverRadius: 7
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            padding: 10,
                            cornerRadius: 8,
                            titleFont: { size: 12 },
                            bodyFont: { size: 13, weight: 'bold' },
                            callbacks: {
                                label: function (ctx) {
                                    return ctx.parsed.y + ' organization' + (ctx.parsed.y === 1 ? '' : 's');
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { precision: 0, color: '#64748b' },
                            grid: { color: '#eef2f7' }
                        },
                        x: {
                            ticks: { color: '#64748b' },
                            grid: { display: false }
                        }
                    },
                    interaction: {
                        intersect: false,
                        mode: 'index'
                    }
                }
            });
        }
    })();
</script>
}