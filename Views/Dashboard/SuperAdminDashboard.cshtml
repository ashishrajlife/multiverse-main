@{
    ViewData["Title"] = "Super Admin Dashboard";
    Layout = "_DashboardLayout";

    // Compact KPI cards. Each one only shows up if the controller actually set its ViewBag value,
    // so nothing renders blank if a value is missing.
    var kpis = new List<(string Label, object Value, string Icon, string Tone)>();
    if (ViewBag.TotalUsers != null)         { kpis.Add(("Total users",   (object)ViewBag.TotalUsers,         "bi-people",       "violet")); }
    if (ViewBag.TotalOrganizations != null) { kpis.Add(("Organizations", (object)ViewBag.TotalOrganizations, "bi-building",     "sky")); }
    if (ViewBag.TotalAdmins != null)        { kpis.Add(("Admins",        (object)ViewBag.TotalAdmins,        "bi-person-badge", "coral")); }
}

@section Styles {
<style>
    /* =====================================================
       SUPER ADMIN DASHBOARD - compact cards
       Builds on _DashboardLayout: .icon-tile, .tone-*, .section-label
    ===================================================== */

    /* One shared grid so KPI cards and module cards line up in the same columns */
    .dash-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
        gap: 14px;
        margin-bottom: 28px;
    }

    .dash-section .section-label { margin-bottom: 12px; }

    /* ---------- KPI mini cards ---------- */
    .kpi-mini {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 16px;
        background: var(--card);
        border: 1px solid var(--card-border);
        border-radius: 14px;
        box-shadow: var(--shadow-sm);
    }

    .kpi-mini .icon-tile {
        flex: 0 0 auto;
        width: 40px;
        height: 40px;
        border-radius: 12px;
        font-size: 18px;
    }

    .kpi-text { min-width: 0; line-height: 1.2; }

    .kpi-label {
        display: block;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--ink-mute);
    }

    .kpi-value {
        display: block;
        margin-top: 2px;
        font-size: 22px;
        font-weight: 800;
        letter-spacing: -0.6px;
        color: var(--ink);
        font-variant-numeric: tabular-nums;
    }

    /* ---------- Module cards ---------- */
    .module-card {
    position: relative;          /* anchor for absolute positioning */
    display: block;
    padding: 1rem;
    border: 2px solid black;
    border-radius: 10px;
    text-decoration: none;
}

.module-header {
    display: flex;
    justify-content: space-between;  /* pushes h3 left, arrow right */
    align-items: center;
    gap: 0.5rem;
}

.module-header h3 {
    margin: 0;
}

.module-arrow {
    font-size: 1.25rem;
    flex-shrink: 0;
    color: black;
}

    .module-card:hover {
        color: var(--ink);
        transform: translateY(-2px);
        border-color: color-mix(in srgb, var(--tone) 55%, var(--line));
        box-shadow: 0 12px 26px -14px color-mix(in srgb, var(--tone) 55%, transparent);
    }

    .module-card:focus-visible {
        outline: 3px solid rgba(74, 144, 226, 0.45);
        outline-offset: 2px;
    }

    .module-card .icon-tile {
        flex: 0 0 auto;
        width: 44px;
        height: 44px;
        border-radius: 12px;
        font-size: 20px;
    }

    .module-text { flex: 1 1 auto; min-width: 0; line-height: 1.3; }

    .module-text h3 {
        margin: 0 0 2px;
        font-size: 14.5px;
        font-weight: 700;
        letter-spacing: -0.1px;
        color: var(--ink);
    }

    .module-text p {
        display: -webkit-box;
        margin: 0;
        overflow: hidden;
        font-size: 12.5px;
        color: var(--ink-mute);
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .module-count {
        flex: 0 0 auto;
        padding: 2px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        color: var(--tone);
        background: var(--tone-soft);
        font-variant-numeric: tabular-nums;
    }

    .module-arrow {
        flex: 0 0 auto;
        font-size: 14px;
        color: var(--ink-mute);
        transition: transform 0.2s ease, color 0.2s ease;
    }

    .module-card:hover .module-arrow {
        color: var(--tone);
        transform: translateX(3px);
    }

    @@media (max-width: 575.98px) {
        .dash-grid { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .module-card, .module-arrow { transition: none; }
        .module-card:hover { transform: none; }
        .module-card:hover .module-arrow { transform: none; }
    }
</style>
}

<div class="page-header">
    <div>
        <h1>Control Center</h1>
        <p class="fw-bold text-black">Complete authority over organizations, users, roles, and the platform</p>
        <div class="page-accent"></div>
    </div>
</div>

<!-- ====================== AUTHORITY MODULES ====================== -->
<section class="dash-section">

  <div class="dash-grid">
    <a asp-controller="Organization" asp-action="Index" class="module-card tone-violet">
        <div class="module-text">
            <div class="module-header">
                <h3>Organizations</h3>
                <i class="bi bi-arrow-right module-arrow text-black"></i>
            </div>
            <hr style="height: 2px;" />
    
            <p class="fw-bold text-black">Create, manage and activate companies across the platform</p>
        </div>
    </a>
</div>
</section>
