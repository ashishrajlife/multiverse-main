@model ERPDemo.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_DashboardLayout";
    var today = DateTime.Today;
}

<div class="rt-page">

    <!-- ============ HEADER ============ -->
    <div class="rt-head">
        <div>
            <h1>Fleet Control Center</h1>
            <p>Live overview — @today.ToString("dddd, dd MMMM yyyy") • Haryana Operations</p>
        </div>
        <span class="rt-badge"><i class="bi bi-shield-check"></i> Admin</span>
    </div>

    <!-- ============ SECTION 1: FLEET HEALTH ============ -->
    <div class="rt-section-label"><i class="bi bi-truck me-2"></i>Fleet Health</div>
    <div class="rt-stats">
        <div class="rt-stat rt-sky">
            <span class="rt-stat-icon"><i class="bi bi-truck-front"></i></span>
            <div>
                <span class="rt-stat-label">Total Vehicles</span>
                <span class="rt-stat-value">@Model.TotalVehicles</span>
            </div>
        </div>
        <div class="rt-stat rt-green">
            <span class="rt-stat-icon"><i class="bi bi-check-circle"></i></span>
            <div>
                <span class="rt-stat-label">Active</span>
                <span class="rt-stat-value">@Model.ActiveVehicles</span>
            </div>
        </div>
        <div class="rt-stat rt-amber">
            <span class="rt-stat-icon"><i class="bi bi-wrench-adjustable"></i></span>
            <div>
                <span class="rt-stat-label">In Maintenance</span>
                <span class="rt-stat-value">@Model.VehiclesInMaintenance</span>
            </div>
        </div>
        <div class="rt-stat rt-violet">
            <span class="rt-stat-icon"><i class="bi bi-pause-circle"></i></span>
            <div>
                <span class="rt-stat-label">Idle</span>
                <span class="rt-stat-value">@Model.IdleVehicles</span>
            </div>
        </div>
        <div class="rt-stat rt-pink">
            <span class="rt-stat-icon"><i class="bi bi-speedometer"></i></span>
            <div>
                <span class="rt-stat-label">Utilization</span>
                <span class="rt-stat-value">@Model.FleetUtilizationPct%</span>
            </div>
        </div>
    </div>

    <!-- ============ SECTION 2: TRIPS & DRIVERS ============ -->
    <div class="rt-section-label"><i class="bi bi-signpost-split me-2"></i>Trips & Drivers</div>
    <div class="rt-stats">
        <div class="rt-stat rt-sky">
            <span class="rt-stat-icon"><i class="bi bi-calendar-check"></i></span>
            <div>
                <span class="rt-stat-label">Trips Today</span>
                <span class="rt-stat-value">@Model.TripsToday</span>
            </div>
        </div>
        <div class="rt-stat rt-green">
            <span class="rt-stat-icon"><i class="bi bi-arrow-repeat"></i></span>
            <div>
                <span class="rt-stat-label">In Progress</span>
                <span class="rt-stat-value">@Model.TripsInProgress</span>
            </div>
        </div>
        <div class="rt-stat rt-coral">
            <span class="rt-stat-icon"><i class="bi bi-exclamation-triangle"></i></span>
            <div>
                <span class="rt-stat-label">Delayed</span>
                <span class="rt-stat-value">@Model.TripsDelayed</span>
            </div>
        </div>
        <div class="rt-stat rt-green">
            <span class="rt-stat-icon"><i class="bi bi-check2-square"></i></span>
            <div>
                <span class="rt-stat-label">Completed Today</span>
                <span class="rt-stat-value">@Model.TripsCompletedToday</span>
            </div>
        </div>
        <div class="rt-stat rt-amber">
            <span class="rt-stat-icon"><i class="bi bi-person-badge"></i></span>
            <div>
                <span class="rt-stat-label">Drivers On Duty</span>
                <span class="rt-stat-value">@Model.DriversOnDuty / @Model.TotalDrivers</span>
            </div>
        </div>
        <div class="rt-stat rt-violet">
            <span class="rt-stat-icon"><i class="bi bi-person-check"></i></span>
            <div>
                <span class="rt-stat-label">Available</span>
                <span class="rt-stat-value">@Model.DriversAvailable</span>
            </div>
        </div>
    </div>

    <!-- ============ SECTION 3: FINANCE ============ -->
    <div class="rt-section-label"><i class="bi bi-currency-rupee me-2"></i>Financials</div>
    <div class="rt-stats">
        <div class="rt-stat rt-green">
            <span class="rt-stat-icon"><i class="bi bi-graph-up-arrow"></i></span>
            <div>
                <span class="rt-stat-label">Revenue Today</span>
                <span class="rt-stat-value">₹@Model.RevenueToday.ToString("N0")</span>
            </div>
        </div>
        <div class="rt-stat rt-coral">
            <span class="rt-stat-icon"><i class="bi bi-fuel-pump"></i></span>
            <div>
                <span class="rt-stat-label">Fuel Cost Today</span>
                <span class="rt-stat-value">₹@Model.FuelCostToday.ToString("N0")</span>
            </div>
        </div>
        <div class="rt-stat rt-amber">
            <span class="rt-stat-icon"><i class="bi bi-receipt"></i></span>
            <div>
                <span class="rt-stat-label">Outstanding</span>
                <span class="rt-stat-value">₹@Model.Outstanding.ToString("N0")</span>
            </div>
        </div>
        <div class="rt-stat rt-sky">
            <span class="rt-stat-icon"><i class="bi bi-people"></i></span>
            <div>
                <span class="rt-stat-label">Active Users</span>
                <span class="rt-stat-value">@Model.ActiveUsers / @Model.TotalUsers</span>
            </div>
        </div>
    </div>

    <!-- ============ SECTION 4: COMPLIANCE ALERTS (HARYANA RTO) ============ -->
    <div class="rt-section-label"><i class="bi bi-shield-exclamation me-2"></i>Compliance Alerts — Next 30 Days</div>
    <div class="rt-alert-grid">
        <div class="rt-alert-card @(Model.InsuranceExpiringSoon > 0 ? "urgent" : "")">
            <i class="bi bi-shield-check"></i>
            <div>
                <span class="rt-alert-num">@Model.InsuranceExpiringSoon</span>
                <span class="rt-alert-label">Insurance Expiring</span>
            </div>
        </div>
        <div class="rt-alert-card @(Model.FitnessExpiringSoon > 0 ? "urgent" : "")">
            <i class="bi bi-patch-check"></i>
            <div>
                <span class="rt-alert-num">@Model.FitnessExpiringSoon</span>
                <span class="rt-alert-label">Fitness Certs</span>
            </div>
        </div>
        <div class="rt-alert-card @(Model.PermitExpiringSoon > 0 ? "urgent" : "")">
            <i class="bi bi-file-earmark-text"></i>
            <div>
                <span class="rt-alert-num">@Model.PermitExpiringSoon</span>
                <span class="rt-alert-label">Permits</span>
            </div>
        </div>
        <div class="rt-alert-card @(Model.PucExpiringSoon > 0 ? "urgent" : "")">
            <i class="bi bi-cloud-haze2"></i>
            <div>
                <span class="rt-alert-num">@Model.PucExpiringSoon</span>
                <span class="rt-alert-label">PUC Certificates</span>
            </div>
        </div>
        <div class="rt-alert-card @(Model.LicenseExpiringSoon > 0 ? "urgent" : "")">
            <i class="bi bi-person-vcard"></i>
            <div>
                <span class="rt-alert-num">@Model.LicenseExpiringSoon</span>
                <span class="rt-alert-label">Driver Licenses</span>
            </div>
        </div>
    </div>

    <!-- ============ SECTION 5: LIVE TRIPS ============ -->
    <section class="rt-window mt-4">
        <div class="rt-titlebar">
            <span><i class="bi bi-broadcast me-2"></i>Live Trips</span>
            <a asp-controller="Trips" asp-action="Index" class="rt-btn">View All</a>
        </div>
        <div class="rt-scroll">
            <table class="rt-table">
                <thead>
                    <tr>
                        <th>Trip #</th>
                        <th>Vehicle</th>
                        <th>Driver</th>
                        <th>Route</th>
                        <th>ETA</th>
                        <th>Status</th>
                        <th class="text-end">Revenue</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ActiveTrips.Any())
                    {
                        foreach (var t in Model.ActiveTrips)
                        {
                            var statusClass = t.Status switch
                            {
                                "InProgress" => "rt-sky",
                                "Delayed"    => "rt-coral",
                                _            => "rt-nodot"
                            };
                            <tr>
                                <td><strong>@t.TripNumber</strong></td>
                                <td>@t.VehicleReg</td>
                                <td>@t.DriverName</td>
                                <td>@t.Route</td>
                                <td>@(t.PlannedEnd?.ToString("MMM dd, HH:mm") ?? "—")</td>
                                <td><span class="rt-tag @statusClass">@t.Status</span></td>
                                <td class="text-end">₹@((t.Revenue ?? 0).ToString("N0"))</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">
                            <i class="bi bi-inbox me-2"></i>No trips currently running.
                        </td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <!-- ============ SECTION 6: MAINTENANCE ============ -->
    <section class="rt-window mt-4">
        <div class="rt-titlebar">
            <span><i class="bi bi-tools me-2"></i>Vehicles in Service</span>
            <a asp-controller="Maintenance" asp-action="Index" class="rt-btn">Manage</a>
        </div>
        <div class="rt-scroll">
            <table class="rt-table">
                <thead>
                    <tr>
                        <th>Vehicle</th>
                        <th>Service Type</th>
                        <th>Date</th>
                        <th class="text-end">Cost</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.VehiclesInService.Any())
                    {
                        foreach (var m in Model.VehiclesInService)
                        {
                            <tr>
                                <td><strong>@m.VehicleReg</strong></td>
                                <td>@m.ServiceType</td>
                                <td>@m.ServiceDate.ToString("MMM dd, yyyy")</td>
                                <td class="text-end">₹@((m.Cost ?? 0).ToString("N0"))</td>
                                <td>
                                    <span class="rt-tag @(m.Status == "InProgress" ? "rt-amber" : "rt-nodot")">@m.Status</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">
                            <i class="bi bi-check2-circle me-2"></i>All vehicles operational. 🚛
                        </td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <!-- ============ SECTION 7: TOP PERFORMERS ============ -->
    <div class="row g-3 mt-4">
        <div class="col-lg-6">
            <section class="rt-window h-100">
                <div class="rt-titlebar">
                    <span><i class="bi bi-trophy me-2"></i>Top Drivers</span>
                </div>
                <div class="rt-scroll">
                    <table class="rt-table">
                        <thead>
                            <tr><th>#</th><th>Driver</th><th class="text-end">Trips</th><th class="text-end">Revenue</th></tr>
                        </thead>
                        <tbody>
                        @if (Model.TopDrivers.Any())
                        {
                            var i = 1;
                            foreach (var d in Model.TopDrivers)
                            {
                                <tr>
                                    <td><span class="rt-rank">@i</span></td>
                                    <td>@d.Name</td>
                                    <td class="text-end">@d.TripsCompleted</td>
                                    <td class="text-end">₹@d.Revenue.ToString("N0")</td>
                                </tr>
                                i++;
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">No completed trips yet.</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <div class="col-lg-6">
            <section class="rt-window h-100">
                <div class="rt-titlebar">
                    <span><i class="bi bi-star me-2"></i>Top Vehicles</span>
                </div>
                <div class="rt-scroll">
                    <table class="rt-table">
                        <thead>
                            <tr><th>#</th><th>Vehicle</th><th class="text-end">Trips</th><th class="text-end">Revenue</th></tr>
                        </thead>
                        <tbody>
                        @if (Model.TopVehicles.Any())
                        {
                            var i = 1;
                            foreach (var v in Model.TopVehicles)
                            {
                                <tr>
                                    <td><span class="rt-rank">@i</span></td>
                                    <td>@v.RegistrationNumber</td>
                                    <td class="text-end">@v.TripsCompleted</td>
                                    <td class="text-end">₹@v.Revenue.ToString("N0")</td>
                                </tr>
                                i++;
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">No trips recorded yet.</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>

    <!-- ============ SECTION 8: RECENT USERS ============ -->
    <section class="rt-window mt-4">
        <div class="rt-titlebar">
            <span><i class="bi bi-people me-2"></i>Recently Added Users</span>
            <a asp-controller="Team" asp-action="ManageAll" class="rt-btn">Manage All</a>
        </div>
        <div class="rt-scroll">
            <table class="rt-table">
                <thead>
                    <tr><th>User</th><th>Email</th><th>Role</th><th>Last Login</th><th>Status</th></tr>
                </thead>
                <tbody>
                @foreach (var u in Model.RecentUsers)
                {
                    <tr>
                        <td>
                            <div class="rt-user">
                                <span class="rt-avatar rt-sky"><i class="bi bi-person"></i></span>
                                <span class="rt-user-name">@u.FullName</span>
                            </div>
                        </td>
                        <td>@u.Email</td>
                        <td><span class="rt-tag rt-nodot">@u.Role?.RoleName</span></td>
                        <td>@(u.LastLoginAt?.ToString("MMM dd, HH:mm") ?? "—")</td>
                        <td>
                            @if (u.IsActive)
                            { <span class="rt-tag rt-green">Active</span> }
                            else
                            { <span class="rt-tag rt-coral">Inactive</span> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    <!-- ============ SECTION 9: QUICK ACTIONS ============ -->
    <section class="rt-window mt-4">
        <div class="rt-titlebar">
            <span><i class="bi bi-lightning-charge me-2"></i>Quick Actions</span>
        </div>
        <div class="p-3 d-flex flex-wrap gap-2">
            <a asp-controller="Vehicles" asp-action="Create" class="rt-btn rt-btn-primary">
                <i class="bi bi-truck-front me-1"></i> Add Vehicle
            </a>
            <a asp-controller="Drivers" asp-action="Create" class="rt-btn rt-btn-primary">
                <i class="bi bi-person-plus me-1"></i> Add Driver
            </a>
            <a asp-controller="Trips" asp-action="Create" class="rt-btn rt-btn-primary">
                <i class="bi bi-plus-circle me-1"></i> Create Trip
            </a>
            <a asp-controller="FuelLogs" asp-action="Create" class="rt-btn">
                <i class="bi bi-fuel-pump me-1"></i> Log Fuel
            </a>
            <a asp-controller="Maintenance" asp-action="Create" class="rt-btn">
                <i class="bi bi-wrench me-1"></i> Log Service
            </a>
            <a asp-controller="Team" asp-action="ManageAll" class="rt-btn">
                <i class="bi bi-people me-1"></i> Manage Team
            </a>
            <a asp-controller="Reports" asp-action="Index" class="rt-btn">
                <i class="bi bi-graph-up me-1"></i> Reports
            </a>
        </div>
    </section>
</div>