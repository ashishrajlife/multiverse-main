@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_DashboardLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/retro.css" asp-append-version="true" />
}

<div class="rt-page">

    <!-- ============ HEADER ============ -->
    <div class="rt-head">
        <div>
            <h1>Admin Dashboard</h1>
            <p>Overview of users, sales, and operations</p>
        </div>
        <span class="rt-badge"><i class="bi bi-person-badge"></i> Admin</span>
    </div>

    <!-- ============ TOP STATS ROW ============ -->
    <div class="rt-stats">
        <div class="rt-stat rt-sky">
            <span class="rt-stat-icon"><i class="bi bi-people"></i></span>
            <div>
                <span class="rt-stat-label">Total Users</span>
                <span class="rt-stat-value">@ViewBag.TotalUsers</span>
            </div>
        </div>
        <div class="rt-stat rt-green">
            <span class="rt-stat-icon"><i class="bi bi-person-check"></i></span>
            <div>
                <span class="rt-stat-label">Active Users</span>
                <span class="rt-stat-value">@ViewBag.ActiveUsers</span>
            </div>
        </div>
        <div class="rt-stat rt-coral">
            <span class="rt-stat-icon"><i class="bi bi-person-dash"></i></span>
            <div>
                <span class="rt-stat-label">Inactive Users</span>
                <span class="rt-stat-value">@(ViewBag.TotalUsers - ViewBag.ActiveUsers)</span>
            </div>
        </div>
    </div>

    <!-- Pending Approvals Widget -->
@if (ViewBag.PendingApprovalsCount != null && (int)ViewBag.PendingApprovalsCount > 0)
{
    <div class="row g-3 mb-4">
        <div class="col-12">
            <a asp-controller="Requisitions" asp-action="PendingApprovals" class="text-decoration-none">
                <div class="rt-window" style="border-left: 5px solid #feca57; cursor: pointer; transition: all 0.15s;"
                     onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 8px 20px rgba(0,0,0,0.08)';"
                     onmouseout="this.style.transform='';this.style.boxShadow='';">
                    <div class="p-3 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div style="width:48px;height:48px;border-radius:50%;background:#fff3cd;color:#856404;display:grid;place-items:center;font-size:22px;">
                                <i class="bi bi-hourglass-split"></i>
                            </div>
                            <div>
                                <div class="fw-bold" style="font-size:16px;color:#2a2f3a;">
                                    @ViewBag.PendingApprovalsCount Requisition(s) Pending Your Approval
                                </div>
                                <div class="text-muted" style="font-size:13px;">
                                    Click to review and approve
                                </div>
                            </div>
                        </div>
                        <div style="font-size:24px;color:#feca57;">
                            <i class="bi bi-arrow-right-circle-fill"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>
}

    <!-- ============ SALES STATS ROW (Module Ready) ============ -->
    <div class="rt-stats">
        <div class="rt-stat rt-violet">
            <span class="rt-stat-icon"><i class="bi bi-cart-check"></i></span>
            <div>
                <span class="rt-stat-label">Today's Orders</span>
                <span class="rt-stat-value">@(ViewBag.TodayOrders ?? 0)</span>
            </div>
        </div>
        <div class="rt-stat rt-amber">
            <span class="rt-stat-icon"><i class="bi bi-receipt"></i></span>
            <div>
                <span class="rt-stat-label">Pending Invoices</span>
                <span class="rt-stat-value">@(ViewBag.PendingInvoices ?? 0)</span>
            </div>
        </div>
        <div class="rt-stat rt-pink">
            <span class="rt-stat-icon"><i class="bi bi-wallet2"></i></span>
            <div>
                <span class="rt-stat-label">Outstanding (₹)</span>
                <span class="rt-stat-value">@((ViewBag.Outstanding ?? 0m).ToString("N0"))</span>
            </div>
        </div>
    </div>

    <!-- ============ RECENT USERS ============ -->
    <section class="rt-window">
        <div class="rt-titlebar">
            <span><i class="bi bi-people me-2"></i>Recent Users</span>
            <a asp-controller="Team" asp-action="ManageAll" class="rt-btn">Manage All</a>
        </div>

        <div class="rt-scroll">
            <table class="rt-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Last Login</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.RecentUsers != null)
                    {
                        foreach (var user in ViewBag.RecentUsers)
                        {
                            <tr>
                                <td>
                                    <div class="rt-user">
                                        <span class="rt-avatar rt-sky"><i class="bi bi-person"></i></span>
                                        <span class="rt-user-name">@user.FullName</span>
                                    </div>
                                </td>
                                <td>@user.Email</td>
                                <td><span class="rt-tag rt-nodot">@user.Role.RoleName</span></td>
                                <td>@(user.LastLoginAt?.ToString("MMM dd, HH:mm") ?? "--s")</td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="rt-tag rt-green">Active</span>
                                    }
                                    else
                                    {
                                        <span class="rt-tag rt-coral">Inactive</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No users yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <!-- ============ RECENT SALES ORDERS (Module Ready) ============ -->
    <section class="rt-window mt-4">
        <div class="rt-titlebar">
            <span><i class="bi bi-cart3 me-2"></i>Recent Sales Orders</span>
            <a asp-controller="SalesOrders" asp-action="Index" class="rt-btn">View All</a>
        </div>

        <div class="rt-scroll">
            <table class="rt-table">
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Customer</th>
                        <th>Amount (₹)</th>
                        <th>Status</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.RecentOrders != null && ((List<dynamic>)ViewBag.RecentOrders).Any())
                    {
                        foreach (var order in ViewBag.RecentOrders)
                        {
                            <tr>
                                <td><strong>@order.OrderNumber</strong></td>
                                <td>@order.CustomerName</td>
                                <td>@order.TotalAmount.ToString("N0")</td>
                                <td>
                                    <span class="rt-tag rt-amber">@order.Status</span>
                                </td>
                                <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="bi bi-inbox me-2"></i>No sales orders yet. Sales module coming soon.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <!-- ============ QUICK ACTIONS ============ -->
    <section class="rt-window mt-4">
        <div class="rt-titlebar">
            <span><i class="bi bi-lightning-charge me-2"></i>Quick Actions</span>
        </div>
        <div class="p-3 d-flex flex-wrap gap-2">
            <a asp-controller="Team" asp-action="Create" class="rt-btn rt-btn-primary">
                <i class="bi bi-person-plus me-1"></i> Add User
            </a>
            <a asp-controller="Team" asp-action="ManageAll" class="rt-btn">
                <i class="bi bi-people me-1"></i> Manage Team
            </a>
            <a asp-controller="Customers" asp-action="Create" class="rt-btn">
                <i class="bi bi-shop me-1"></i> Add Customer
            </a>
            <a asp-controller="Products" asp-action="Create" class="rt-btn">
                <i class="bi bi-box me-1"></i> Add Product
            </a>
        </div>
    </section>

</div>