@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_DashboardLayout";
}

@section Styles {
<link rel="stylesheet" href="~/css/retro.css" asp-append-version="true" />
}

<div class="rt-page">

    <div class="rt-head">
        <div>
            <h1>Admin Dashboard</h1>
            <p>Manage users and operations</p>
        </div>
        <span class="rt-badge"><i class="bi bi-person-badge"></i> Admin</span>
    </div>

    <div class="rt-stats">
        <div class="rt-stat rt-sky">
            <span class="rt-stat-icon"><i class="bi bi-people"></i></span>
            <div>
                <span class="rt-stat-label">Total users</span>
                <span class="rt-stat-value">@ViewBag.TotalUsers</span>
            </div>
        </div>
        <div class="rt-stat rt-green">
            <span class="rt-stat-icon"><i class="bi bi-person-check"></i></span>
            <div>
                <span class="rt-stat-label">Active users</span>
                <span class="rt-stat-value">@ViewBag.ActiveUsers</span>
            </div>
        </div>
        <div class="rt-stat rt-coral">
            <span class="rt-stat-icon"><i class="bi bi-person-dash"></i></span>
            <div>
                <span class="rt-stat-label">Inactive users</span>
                <span class="rt-stat-value">@(ViewBag.TotalUsers - ViewBag.ActiveUsers)</span>
            </div>
        </div>
    </div>

    <section class="rt-window">
        <div class="rt-titlebar">
            <span><i class="bi bi-people me-2"></i>Recent users</span>
            <a asp-controller="Team" asp-action="ManageAll" class="rt-btn">Manage All</a>
        </div>

        <div class="rt-scroll">
            <table class="rt-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Last login</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in ViewBag.RecentUsers)
                    {
                        <tr>
                            <td>
                                <div class="rt-user">
                                    <span class="rt-avatar rt-sky"><i class="bi bi-person"></i></span>
                                    <span class="rt-user-name">@user.FullName</span>
                                </div>
                            </td>
                            <td>@user.Email</td>
                            <td><span class="rt-tag rt-nodot">@user.Role.RoleName</span></td>
                            <td>@(user.LastLoginAt?.ToString("MMM dd, HH:mm") ?? "Never")</td>
                            <td><span class="rt-tag rt-green">Active</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

</div>
