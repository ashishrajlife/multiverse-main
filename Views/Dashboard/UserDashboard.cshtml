@{
    ViewData["Title"] = "My Dashboard";
    Layout = "_DashboardLayout";
    var user = ViewBag.User as ERPDemo.Models.User;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">Welcome, @user?.FullName</h1>
            <p class="text-muted mb-0">Here's your personal dashboard</p>
        </div>
        <span class="badge bg-primary fs-6 px-3 py-2"><i class="bi bi-person me-1"></i>@user?.Role?.RoleName</span>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-4">
                    <div class="rounded-circle bg-primary bg-opacity-10 d-inline-flex p-4 mb-3">
                        <i class="bi bi-person-circle fs-1 text-primary"></i>
                    </div>
                    <h4 class="fw-bold">@user?.FullName</h4>
                    <p class="text-muted mb-1">@user?.Email</p>
                    <span class="badge bg-primary">@user?.Role?.RoleName</span>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2"></i>My Information</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="text-muted small">Username</label>
                            <p class="fw-semibold mb-0">@user?.Username</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Phone</label>
                            <p class="fw-semibold mb-0">@(user?.PhoneNumber ?? "Not set")</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Last Login</label>
                            <p class="fw-semibold mb-0">@(user?.LastLoginAt?.ToString("MMM dd, yyyy HH:mm") ?? "First login")</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Member Since</label>
                            <p class="fw-semibold mb-0">@user?.CreatedAt.ToString("MMM dd, yyyy")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>