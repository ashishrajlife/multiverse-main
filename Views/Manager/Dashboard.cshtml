@{
    ViewData["Title"] = "Manager Dashboard";
    Layout = "_DashboardLayout";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="rt-head mb-4">
    <div class="rt-head-left">
        <div>
            <h1>Welcome, @ViewBag.ManagerName 👋</h1>
            <p class="text-muted mb-0">Department: <strong>@ViewBag.DepartmentName</strong></p>
        </div>
    </div>
</div>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="rt-window p-3">
            <div class="d-flex align-items-center">
                <div class="me-3" style="font-size: 32px; color: #0d6efd;">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Total Team Members</div>
                    <div class="fw-bold" style="font-size: 24px;">@ViewBag.TeamCount</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="rt-window p-3">
            <div class="d-flex align-items-center">
                <div class="me-3" style="font-size: 32px; color: #198754;">
                    <i class="bi bi-person-check-fill"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Active Employees</div>
                    <div class="fw-bold" style="font-size: 24px;">@ViewBag.ActiveCount</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="rt-window p-3">
            <div class="d-flex align-items-center">
                <div class="me-3" style="font-size: 32px; color: #dc3545;">
                    <i class="bi bi-person-x-fill"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Inactive Employees</div>
                    <div class="fw-bold" style="font-size: 24px;">@ViewBag.InactiveCount</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Team Members Table -->
<div class="rt-window">
    <div class="rt-titlebar">
        <span>My Team Members</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle mb-0" style="font-size: 14px;">
            <thead class="table-dark text-uppercase text-center" style="font-size: 12px;">
                <tr>
                    <th class="text-center">Employee</th>
                    <th class="text-center">Email</th>
                    <th class="text-center">Phone</th>
                    <th class="text-center">Designation</th>
                    <th class="text-center">Shift</th>
                    <th class="text-center">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.TeamMembers != null && ((List<ERPDemo.Models.User>)ViewBag.TeamMembers).Any())
                {
                    foreach (var m in (List<ERPDemo.Models.User>)ViewBag.TeamMembers)
                    {
                        <tr>
                            <td class="text-center">
                                <div class="fw-bold">@m.FullName</div>
                                <div class="text-muted" style="font-size:11px;">@@@m.Username</div>
                            </td>
                            <td class="text-center">@m.Email</td>
                            <td class="text-center">@(string.IsNullOrEmpty(m.PhoneNumber) ? "N/A" : m.PhoneNumber)</td>
                            <td class="text-center">@(string.IsNullOrEmpty(m.Designation) ? "N/A" : m.Designation)</td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(m.ShiftStartTime) && !string.IsNullOrEmpty(m.ShiftEndTime))
                                {
                                    <span class="badge bg-light text-dark border">@m.ShiftStartTime - @m.ShiftEndTime</span>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (m.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            No team members found in your department.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>