@model ERPDemo.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_DashboardLayout";
}

<div class="rt-head">
    <div class="rt-head-left">
        <a asp-action="Dashboard" class="rt-btn rt-btn-back" title="Back">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h1>Reset Password</h1>
            <p>Reset password for <strong>@ViewBag.UserName</strong></p>
        </div>
    </div>
</div>

<div class="rt-window" style="max-width: 600px;">
    <div class="rt-titlebar"><span>Set New Password</span></div>
    <div class="p-4">
        <form asp-action="ResetPassword" method="post" asp-antiforgery="true">
            <input type="hidden" asp-for="UserId" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label fw-semibold" style="font-size:13px;">New Password</label>
                <input asp-for="NewPassword" type="password" class="rt-field w-100" placeholder="Min 4 characters" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label fw-semibold" style="font-size:13px;">Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" class="rt-field w-100" placeholder="Re-enter password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="alert alert-info d-flex align-items-center small mb-3">
                <i class="bi bi-info-circle me-2"></i>
                User ko naya password batana padega — ye unko automatically nahi milega.
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="rt-btn rt-btn-primary">
                    <i class="bi bi-key me-1"></i> Reset Password
                </button>
                <a asp-action="Dashboard" class="rt-btn">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}