@{
    ViewData["Title"] = "HOD Dashboard";
    Layout = "_DashboardLayout";
    var teamMembers = ViewBag.TeamMembers as List<ERPDemo.Models.User> ?? new List<ERPDemo.Models.User>();
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<!-- Header -->
<div class="rt-head mb-4">
    <div class="rt-head-left">
        <div>
            <h1>Welcome, @ViewBag.HodName 👋</h1>
            <p class="text-muted mb-0">Department: <strong>@ViewBag.DepartmentName</strong> (HOD)</p>
        </div>
    </div>
    <div class="rt-head-right">
        <a asp-controller="Hod" asp-action="Create" class="rt-btn rt-btn-primary">
            <i class="bi bi-person-plus me-1"></i> Add Member
        </a>
    </div>
</div>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="rt-window p-3">
            <div class="d-flex align-items-center">
                <div class="me-3" style="font-size: 32px; color: #0d6efd;">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Total Members</div>
                    <div class="fw-bold" style="font-size: 24px;">@ViewBag.TotalCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="rt-window p-3">
            <div class="d-flex align-items-center">
                <div class="me-3" style="font-size: 32px; color: #6f42c1;">
                    <i class="bi bi-person-badge-fill"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Managers</div>
                    <div class="fw-bold" style="font-size: 24px;">@ViewBag.ManagerCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="rt-window p-3">
            <div class="d-flex align-items-center">
                <div class="me-3" style="font-size: 32px; color: #198754;">
                    <i class="bi bi-person-check-fill"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Employees</div>
                    <div class="fw-bold" style="font-size: 24px;">@ViewBag.EmployeeCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="rt-window p-3">
            <div class="d-flex align-items-center">
                <div class="me-3" style="font-size: 32px; color: #fd7e14;">
                    <i class="bi bi-person-check-fill"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Active</div>
                    <div class="fw-bold" style="font-size: 24px;">@ViewBag.ActiveCount</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Pending Approvals Widget -->
@if (ViewBag.PendingApprovalsCount != null && (int)ViewBag.PendingApprovalsCount > 0)
{
    <div class="row g-3 mb-4">
        <div class="col-12">
            <a asp-controller="Requisitions" asp-action="PendingApprovals" class="text-decoration-none">
                <div class="rt-window" style="border-left: 5px solid #feca57; cursor: pointer; transition: all 0.15s;"
                     onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 8px 20px rgba(0,0,0,0.08)';"
                     onmouseout="this.style.transform='';this.style.boxShadow='';">
                    <div class="p-3 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div style="width:48px;height:48px;border-radius:50%;background:#fff3cd;color:#856404;display:grid;place-items:center;font-size:22px;">
                                <i class="bi bi-hourglass-split"></i>
                            </div>
                            <div>
                                <div class="fw-bold" style="font-size:16px;color:#2a2f3a;">
                                    @ViewBag.PendingApprovalsCount Requisition(s) Pending Your Approval
                                </div>
                                <div class="text-muted" style="font-size:13px;">
                                    Click to review and approve
                                </div>
                            </div>
                        </div>
                        <div style="font-size:24px;color:#feca57;">
                            <i class="bi bi-arrow-right-circle-fill"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>
}

<!-- Team Table -->
<div class="rt-window">
    <div class="rt-titlebar">
        <span>Department Members</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover table-bordered border-secondary align-middle mb-0" style="font-size: 15px;">
            <thead class="table-dark text-uppercase text-center" style="font-size: 12px;">
                <tr>
                    <th class="text-center">Name</th>
                    <th class="text-center">Role</th>
                    <th class="text-center">Phone</th>
                    <th class="text-center">City</th>
                    <th class="text-center">State</th>
                    <th class="text-center">Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (teamMembers.Any())
                {
                    foreach (var m in teamMembers)
                    {
                        <tr>
                            <td class="text-center">
                                <div class="fw-bold">@m.FullName</div>
                                <div class="text-muted" style="font-size:11px;">@@@m.Username</div>
                            </td>
                            <td class="text-center">
                                @if (m.RoleId == 2)
                                {
                                    <span class="badge bg-info text-dark">Manager</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Employee</span>
                                }
                            </td>
                            <td class="text-center">@(string.IsNullOrEmpty(m.PhoneNumber) ? "N/A" : m.PhoneNumber)</td>
                            <td class="text-center">@(string.IsNullOrEmpty(m.City) ? "N/A" : m.City)</td>
                            <td class="text-center">@(string.IsNullOrEmpty(m.State) ? "N/A" : m.State)</td>
                            <td class="text-center">
                                @if (m.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <!-- View -->
                                    <button type="button" class="rt-btn" data-bs-toggle="modal" data-bs-target="#viewModal-@m.UserId">
                                        <i class="bi bi-eye text-primary"></i>
                                    </button>

                                    <!-- Edit -->
                                    <a asp-controller="Hod" asp-action="Edit" asp-route-id="@m.UserId" class="rt-btn" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <!-- Reset Password (Key) — Sirf Manager ke liye (HOD khud Employee nahi banayega) -->
                                    @if (m.RoleId == 2)   @* Sirf Manager ke liye *@
                                    {
                                        <a asp-controller="Hod" asp-action="ResetPassword" asp-route-id="@m.UserId" class="rt-btn" title="Reset Password">
                                            <i class="bi bi-key"></i>
                                        </a>
                                    }

                                    <!-- Delete -->
                                    <form asp-controller="Hod" asp-action="Delete" asp-route-id="@m.UserId" method="post" class="d-inline"
                                        onsubmit="return confirm('Are you sure?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="rt-btn text-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            No members found in your department.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- View Modals (same as Manager dashboard) -->
@foreach (var m in teamMembers)
{
    <div class="modal fade" id="viewModal-@m.UserId" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content" style="border-radius: 12px; border: none;">
                <div class="modal-header bg-dark text-white" style="border-top-left-radius: 12px; border-top-right-radius: 12px;">
                    <h5 class="modal-title"><i class="bi bi-person-badge me-2"></i> @m.FullName's Profile</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">Basic Information</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6"><label class="text-muted small fw-semibold">Username</label><div class="fw-bold">@m.Username</div></div>
                        <div class="col-md-6"><label class="text-muted small fw-semibold">Email</label><div class="fw-bold">@m.Email</div></div>
                        <div class="col-md-6"><label class="text-muted small fw-semibold">Phone</label><div class="fw-bold">@(string.IsNullOrEmpty(m.PhoneNumber) ? "N/A" : m.PhoneNumber)</div></div>
                        <div class="col-md-6"><label class="text-muted small fw-semibold">Status</label><div>@(m.IsActive ? "Active" : "Inactive")</div></div>
                    </div>
                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">Personal & Contact</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-12"><label class="text-muted small fw-semibold">Address</label><div class="fw-bold">@(string.IsNullOrEmpty(m.Address) ? "N/A" : m.Address)</div></div>
                        <div class="col-md-4"><label class="text-muted small fw-semibold">City</label><div class="fw-bold">@(string.IsNullOrEmpty(m.City) ? "N/A" : m.City)</div></div>
                        <div class="col-md-4"><label class="text-muted small fw-semibold">State</label><div class="fw-bold">@(string.IsNullOrEmpty(m.State) ? "N/A" : m.State)</div></div>
                        <div class="col-md-4"><label class="text-muted small fw-semibold">Pincode</label><div class="fw-bold">@(string.IsNullOrEmpty(m.Pincode) ? "N/A" : m.Pincode)</div></div>
                        <div class="col-md-6"><label class="text-muted small fw-semibold">Aadhaar</label><div class="fw-bold">@(string.IsNullOrEmpty(m.AadhaarNumber) ? "N/A" : m.AadhaarNumber)</div></div>
                        <div class="col-md-6"><label class="text-muted small fw-semibold">PAN</label><div class="fw-bold">@(string.IsNullOrEmpty(m.PanNumber) ? "N/A" : m.PanNumber)</div></div>
                    </div>
                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">Employment Details</h6>
                    <div class="row g-3">
                        <div class="col-md-4"><label class="text-muted small fw-semibold">Type</label><div class="fw-bold">@(string.IsNullOrEmpty(m.EmploymentType) ? "N/A" : m.EmploymentType)</div></div>
                        <div class="col-md-4"><label class="text-muted small fw-semibold">Designation</label><div class="fw-bold">@(string.IsNullOrEmpty(m.Designation) ? "N/A" : m.Designation)</div></div>
                        <div class="col-md-4"><label class="text-muted small fw-semibold">Plant</label><div class="fw-bold">@(string.IsNullOrEmpty(m.PlantLocation) ? "N/A" : m.PlantLocation)</div></div>
                        <div class="col-md-4"><label class="text-muted small fw-semibold">Joining</label><div class="fw-bold">@(m.JoiningDate.HasValue ? m.JoiningDate.Value.ToString("dd MMM yyyy") : "N/A")</div></div>
                        <div class="col-md-4">
                            <label class="text-muted small fw-semibold">Shift</label>
                            <div class="fw-bold">
                                @if (!string.IsNullOrEmpty(m.ShiftStartTime) && !string.IsNullOrEmpty(m.ShiftEndTime))
                                {
                                    <span class="badge bg-light text-dark border">@m.ShiftStartTime - @m.ShiftEndTime</span>
                                }
                                else { <span>N/A</span> }
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small fw-semibold">Salary</label>
                            <div class="fw-bold">
                                @if (!string.IsNullOrEmpty(m.SalaryType))
                                {
                                    <span>@m.SalaryType @(m.SalaryAmount.HasValue ? $"- ₹{m.SalaryAmount.Value:N2}" : "")</span>
                                }
                                else { <span>N/A</span> }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light" style="border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <button type="button" class="rt-btn" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}