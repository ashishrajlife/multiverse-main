@model ERPDemo.Models.MaintenanceLog
@{
    ViewData["Title"] = "Log Service";
    Layout = "_DashboardLayout";
    var vehicles = ViewBag.Vehicles as List<ERPDemo.Models.Vehicle> ?? new();
}

<div class="rt-page">
    <div class="rt-head">
        <div>
            <h1>Log Service</h1>
            <p>Record maintenance / repair</p>
        </div>
        <a asp-action="Index" class="rt-btn"><i class="bi bi-arrow-left me-1"></i> Back</a>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="rt-alert rt-alert-error mb-3"></div>

        <section class="rt-window">
            <div class="rt-titlebar">
                <span><i class="bi bi-wrench me-2"></i>Service Details</span>
            </div>
            <div class="p-3 row g-3">
                <div class="col-md-6">
                    <label class="rt-label">Vehicle *</label>
                    <select name="VehicleId" class="rt-input" required>
                        <option value="">-- Select Vehicle --</option>
                        @foreach (var v in vehicles)
                        {
                            <option value="@v.VehicleId" selected="@(Model.VehicleId == v.VehicleId)">
                                @v.RegistrationNumber — @v.VehicleType
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="rt-label">Service Type *</label>
                    <select name="ServiceType" class="rt-input" required>
                        <option value="">-- Select --</option>
                        @foreach (var t in new[] { "Oil Change", "Tyre Replacement", "Brake Service", "Engine Repair", "AC Service", "General Service", "Body Work", "Other" })
                        {
                            <option value="@t" selected="@(Model.ServiceType == t)">@t</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="rt-label">Service Date *</label>
                    <input name="ServiceDate" type="date" class="rt-input" required
                           value="@Model.ServiceDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4">
                    <label class="rt-label">Cost (₹)</label>
                    <input name="Cost" type="number" step="1" class="rt-input"
                           value="@Model.Cost" placeholder="e.g. 5000" />
                </div>
                <div class="col-md-4">
                    <label class="rt-label">Status *</label>
                    <select name="Status" class="rt-input" required>
                        @foreach (var s in new[] { "Scheduled", "InProgress", "Completed" })
                        {
                            <option value="@s" selected="@(Model.Status == s)">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-12">
                    <label class="rt-label">Notes</label>
                    <textarea name="Notes" class="rt-input" rows="2"
                              placeholder="Any additional details...">@Model.Notes</textarea>
                </div>
            </div>
        </section>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="rt-btn rt-btn-primary">
                <i class="bi bi-check-circle me-1"></i> Save Service Log
            </button>
            <a asp-action="Index" class="rt-btn">Cancel</a>
        </div>
    </form>
</div>