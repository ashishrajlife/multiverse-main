@model List<ERPDemo.Models.MaintenanceLog>
@{
    ViewData["Title"] = "Maintenance";
    Layout = "_DashboardLayout";
}

<div class="rt-page">
    <div class="rt-head">
        <div>
            <h1>Maintenance</h1>
            <p>@Model.Count entries · ₹@(((decimal)ViewBag.TotalCost).ToString("N0")) total</p>
        </div>
        <a asp-action="Create" class="rt-btn rt-btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Log Service
        </a>
    </div>

    <form method="get" class="rt-filter-bar">
        <input type="text" name="search" value="@ViewBag.Search" placeholder="Vehicle reg no..." class="rt-input" style="max-width:240px;" />
        <select name="status" class="rt-input" style="max-width:160px;">
            @foreach (var s in (List<string>)ViewBag.StatusOptions)
            {
                <option value="@s" selected="@(s == ViewBag.Status)">@s</option>
            }
        </select>
        <button type="submit" class="rt-btn rt-btn-primary"><i class="bi bi-search me-1"></i> Filter</button>
        <a asp-action="Index" class="rt-btn">Clear</a>
    </form>

    <section class="rt-window mt-3">
        <div class="rt-scroll">
            <table class="rt-table rt-table-vehicles" style="width:100%; table-layout:fixed;">
                <colgroup>
                    <col style="width: 14%;" />
                    <col style="width: 15%;" />
                    <col style="width: 15%;" />
                    <col style="width: 12%;" />
                    <col style="width: 12%;" />
                    <col style="width: 15%;" />
                    <col style="width: 17%;" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Vehicle</th>
                        <th>Service Type</th>
                        <th>Cost</th>
                        <th>Status</th>
                        <th>Notes</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Any())
                {
                    foreach (var m in Model)
                    {
                        var statusClass = m.Status switch
                        {
                            "Completed"  => "rt-green",
                            "InProgress" => "rt-amber",
                            "Scheduled"  => "rt-sky",
                            _            => "rt-nodot"
                        };
                        <tr>
                            <td>@m.ServiceDate.ToString("MMM dd, yyyy")</td>
                            <td><strong>@(m.Vehicle?.RegistrationNumber ?? "—")</strong></td>
                            <td>@m.ServiceType</td>
                            <td>₹@((m.Cost ?? 0).ToString("N0"))</td>
                            <td><span class="rt-tag @statusClass">@m.Status</span></td>
                            <td>@(m.Notes ?? "—")</td>
                            <td>
                                <div class="rt-action-group">
                                    @if (m.Status != "Completed")
                                    {
                                        <form asp-action="Complete" asp-route-id="@m.MaintenanceId" method="post"
                                              onsubmit="return confirm('Mark as complete?');" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="rt-btn rt-btn-sm rt-btn-success" title="Complete">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <form asp-action="Delete" asp-route-id="@m.MaintenanceId" method="post"
                                              onsubmit="return confirm('Delete?');" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="rt-btn rt-btn-sm rt-btn-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="text-center text-muted py-5">
                        <i class="bi bi-tools fs-3 d-block mb-2"></i>
                        Koi maintenance log nahi. <a asp-action="Create" class="d-block mt-2">Log first service →</a>
                    </td></tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>