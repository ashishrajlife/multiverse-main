@model ERPDemo.ViewModels.TripFormViewModel
@{
    ViewData["Title"] = "Create Trip";
    Layout = "_DashboardLayout";
}

<div class="rt-page">

    <div class="rt-head">
        <div>
            <h1>Create Trip</h1>
            <p>Naya trip plan karo — vehicle + driver assign</p>
        </div>
        <a asp-action="Index" class="rt-btn">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="rt-alert rt-alert-error mb-3"></div>

        <section class="rt-window">
            <div class="rt-titlebar">
                <span><i class="bi bi-truck me-2"></i>Assign Vehicle & Driver</span>
            </div>
            <div class="p-3 row g-3">
                <div class="col-md-6">
                    <label asp-for="VehicleId" class="rt-label"></label>
                    <select asp-for="VehicleId" class="rt-input">
                        <option value="">-- Select Vehicle --</option>
                        @foreach (var v in Model.AvailableVehicles)
                        {
                            <option value="@v.VehicleId">@v.Label</option>
                        }
                    </select>
                    <span asp-validation-for="VehicleId" class="text-danger small"></span>
                    @if (!Model.AvailableVehicles.Any())
                    {
                        <small class="text-warning d-block mt-1" style="font-size:11.5px;">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            Koi available vehicle nahi. Pehle Vehicles module se add karo.
                        </small>
                    }
                </div>
                <div class="col-md-6">
                    <label asp-for="DriverId" class="rt-label"></label>
                    <select asp-for="DriverId" class="rt-input">
                        <option value="">-- Select Driver --</option>
                        @foreach (var d in Model.AvailableDrivers)
                        {
                            <option value="@d.DriverId">@d.Label</option>
                        }
                    </select>
                    <span asp-validation-for="DriverId" class="text-danger small"></span>
                    @if (!Model.AvailableDrivers.Any())
                    {
                        <small class="text-warning d-block mt-1" style="font-size:11.5px;">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            Koi available driver nahi. Pehle Drivers module se add karo.
                        </small>
                    }
                </div>
            </div>
        </section>

        <section class="rt-window mt-3">
            <div class="rt-titlebar">
                <span><i class="bi bi-geo-alt me-2"></i>Route</span>
            </div>
            <div class="p-3 row g-3">
                <div class="col-md-6">
                    <label asp-for="OriginCity" class="rt-label"></label>
                    <input asp-for="OriginCity" class="rt-input" list="cityList" placeholder="e.g. Gurugram" />
                    <span asp-validation-for="OriginCity" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DestinationCity" class="rt-label"></label>
                    <input asp-for="DestinationCity" class="rt-input" list="cityList" placeholder="e.g. Jaipur" />
                    <span asp-validation-for="DestinationCity" class="text-danger small"></span>
                </div>
                <datalist id="cityList">
                    @foreach (var c in Model.HaryanaCities)
                    {
                        <option value="@c"></option>
                    }
                </datalist>
            </div>
        </section>

        <section class="rt-window mt-3">
            <div class="rt-titlebar">
                <span><i class="bi bi-calendar-range me-2"></i>Timing</span>
            </div>
            <div class="p-3 row g-3">
                <div class="col-md-6">
                    <label asp-for="PlannedStart" class="rt-label"></label>
                    <input asp-for="PlannedStart" class="rt-input" type="datetime-local"
                           value="@(Model.PlannedStart?.ToString("yyyy-MM-ddTHH:mm"))" />
                    <span asp-validation-for="PlannedStart" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PlannedEnd" class="rt-label"></label>
                    <input asp-for="PlannedEnd" class="rt-input" type="datetime-local"
                           value="@(Model.PlannedEnd?.ToString("yyyy-MM-ddTHH:mm"))" />
                    <span asp-validation-for="PlannedEnd" class="text-danger small"></span>
                </div>
            </div>
        </section>

        <section class="rt-window mt-3">
            <div class="rt-titlebar">
                <span><i class="bi bi-currency-rupee me-2"></i>Financials (Optional)</span>
            </div>
            <div class="p-3 row g-3">
                <div class="col-md-4">
                    <label asp-for="DistanceKm" class="rt-label"></label>
                    <input asp-for="DistanceKm" class="rt-input" type="number" step="0.1" placeholder="e.g. 250" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Revenue" class="rt-label"></label>
                    <input asp-for="Revenue" class="rt-input" type="number" step="1" placeholder="₹" />
                </div>
                <div class="col-md-4">
                    <label asp-for="FuelCost" class="rt-label"></label>
                    <input asp-for="FuelCost" class="rt-input" type="number" step="1" placeholder="₹" />
                </div>
            </div>
        </section>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="rt-btn rt-btn-primary">
                <i class="bi bi-check-circle me-1"></i> Create Trip
            </button>
            <a asp-action="Index" class="rt-btn">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}