@model ERPDemo.ViewModels.CreateOrganizationViewModel
@{
    ViewData["Title"] = "New Organization";
    Layout = "_DashboardLayout";

    // Works whether Plan is a string or an enum. Basic is the default choice.
    var selectedPlan = Model?.Plan?.ToString();
    if (string.IsNullOrEmpty(selectedPlan)) { selectedPlan = "Basic"; }

    var plans = new[]
    {
        new { Name = "Basic",      Icon = "bi-box-seam",        Tone = "sky",    Desc = "For getting started" },
        new { Name = "Pro",        Icon = "bi-lightning-charge", Tone = "violet", Desc = "For growing teams" },
        new { Name = "Enterprise", Icon = "bi-gem",             Tone = "amber",  Desc = "For large organizations" }
    };
}

@section Styles {
<style>
    /* =====================================================
       PAGE LAYOUT  (main column + sticky side column)
       Uses the tokens/components from _DashboardLayout:
       .panel, .panel-header, .icon-tile, .pill, .tone-*
    ===================================================== */
    .org-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 24px;
        align-items: start;
    }

    .org-main,
    .org-aside { display: grid; gap: 24px; min-width: 0; }

    .org-pair {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 24px;
    }

    .org-pair > .panel { height: 100%; }

    /* Live preview only makes sense when there is room for a side column */
    .preview-panel { display: none; }

    @@media (min-width: 1200px) {
        .org-layout { grid-template-columns: minmax(0, 1fr) 340px; }
        .org-aside  { position: sticky; top: calc(var(--topbar-h) + 24px); }
        .preview-panel { display: block; }
        .org-actions .panel-body { flex-direction: column; }
    }

    @@media (min-width: 1440px) {
        .org-layout { grid-template-columns: minmax(0, 1fr) 380px; }
        .org-pair   { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    /* =====================================================
       PANELS (headers with subtitle, roomier body)
    ===================================================== */
    .org-form .panel-title { min-width: 0; }
    .org-form .panel-header p {
        margin: 2px 0 0;
        font-size: 12.5px;
        color: var(--ink-mute);
    }
    .org-form .panel-header .icon-tile { width: 40px; height: 40px; border-radius: 12px; font-size: 18px; }
    .org-form .panel-header { padding: 18px 24px; }
    .form-body { padding: 24px; }

    /* =====================================================
       FORM CONTROLS
    ===================================================== */
    .org-form .form-label {
        margin-bottom: 6px;
        font-size: 13px;
        font-weight: 600;
        color: var(--ink-soft);
    }

    .org-form .label-hint {
        font-weight: 500;
        color: var(--ink-mute);
    }

    .org-form .form-control {
        min-height: 46px;
        border: 1px solid var(--line);
        border-radius: 12px;
        font-size: 14.5px;
        color: var(--ink);
        background-color: #fff;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .org-form .form-control::placeholder { color: #a7b2c3; }

    .org-form .form-control:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(74, 144, 226, 0.15);
    }

    .org-form .btn {
        min-height: 46px;
        padding: 0 22px;
        border-radius: 12px;
        font-size: 14.5px;
        font-weight: 600;
    }

    .org-form .btn-primary {
        background: var(--primary);
        border-color: var(--primary);
    }

    .org-form .btn-primary:hover:not(:disabled),
    .org-form .btn-primary:focus-visible {
        background: var(--primary-deep);
        border-color: var(--primary-deep);
    }

    .org-form .btn:focus-visible {
        outline: 3px solid rgba(74, 144, 226, 0.45);
        outline-offset: 2px;
        box-shadow: none;
    }

    .org-form .btn-outline-secondary {
        color: var(--ink-soft);
        border-color: var(--line);
        background: #fff;
    }

    .org-form .btn-outline-secondary:hover {
        color: var(--ink);
        background: #f8fafd;
        border-color: #cfd8e6;
    }

    .field-error { display: block; margin-top: 4px; font-size: 12.5px; }

    /* Icon inside the input (left side) */
    .icon-field { position: relative; }

    .icon-field > .field-icon {
        position: absolute;
        top: 50%;
        left: 15px;
        transform: translateY(-50%);
        font-size: 16px;
        color: var(--ink-mute);
        pointer-events: none;
    }

    .icon-field .form-control { padding-left: 42px; }

    .org-form .validation-summary-errors {
        margin-bottom: 24px;
        padding: 12px 16px;
        border-radius: 12px;
        font-size: 13.5px;
        font-weight: 500;
        color: #d1303c;
        background: #ffecee;
        border: 1px solid #ffd0d5;
    }

    .org-form .validation-summary-errors ul { margin: 0; padding-left: 18px; }

    /* =====================================================
       GST VERIFY UI
    ===================================================== */
    .gst-row { display: flex; gap: 10px; }

    .gst-input-wrap { flex: 1 1 auto; min-width: 0; }

    .gst-input-wrap .form-control {
        padding-right: 46px;   /* room for the green tick */
        letter-spacing: 0.6px;
        font-weight: 600;
    }

    .gst-count {
        font-size: 12px;
        font-weight: 600;
        color: var(--ink-mute);
        font-variant-numeric: tabular-nums;
    }

    /* Green tick badge, inside the input on the far right */
    .gst-tick {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%) scale(0);
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: #22c55e;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        pointer-events: none;
        box-shadow: 0 2px 8px rgba(34, 197, 94, 0.4);
    }

    .gst-tick.show { transform: translateY(-50%) scale(1); }

    .gst-input-wrap.has-error .form-control {
        border-color: #ef4444 !important;
        box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.15) !important;
    }

    .gst-input-wrap.has-success .form-control {
        border-color: #22c55e !important;
        box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.15) !important;
    }

    .gst-input-wrap.is-loading .form-control {
        border-color: #4A90E2 !important;
        box-shadow: 0 0 0 3px rgba(74, 144, 226, 0.15) !important;
    }

    #verifyGstBtn {
        flex: 0 0 auto;
        min-width: 124px;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    #verifyGstBtn:hover:not(:disabled) {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px -6px rgba(74, 144, 226, 0.55);
    }

    /* Result message */
    #gstResult { min-height: 22px; margin-top: 10px; font-size: 13px; }

    #gstResult .result-success,
    #gstResult .result-error,
    #gstResult .result-loading {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 10px;
        font-weight: 500;
    }

    #gstResult .result-success { color: #167a40; background: #e0f7e9; }
    #gstResult .result-error   { color: #d1303c; background: #ffecee; }
    #gstResult .result-loading { color: var(--ink-soft); background: #edf1f6; font-style: italic; }

    /* Auto-fill flash animation */
    .auto-filled { animation: flashGreen 1s ease; }

    @@keyframes flashGreen {
        0%   { background-color: rgba(34, 197, 94, 0.15); }
        100% { background-color: #fff; }
    }

    /* =====================================================
       PLAN PICKER
    ===================================================== */
    .plan-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 14px;
    }

    .plan-card { position: relative; display: block; margin: 0; cursor: pointer; }

    .plan-card input {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        margin: 0;
        opacity: 0;
        cursor: pointer;
    }

    .plan-body {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px;
        border: 1.5px solid var(--line);
        border-radius: 14px;
        background: #fff;
        transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    }

    .plan-body .icon-tile { width: 42px; height: 42px; border-radius: 12px; font-size: 19px; }

    .plan-card:hover .plan-body {
        border-color: color-mix(in srgb, var(--tone) 45%, var(--line));
    }

    .plan-card input:checked + .plan-body {
        border-color: var(--tone);
        background: var(--tone-soft);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--tone) 16%, transparent);
    }

    .plan-card input:checked + .plan-body .icon-tile { background: #fff; }

    .plan-card input:focus-visible + .plan-body {
        outline: 3px solid rgba(74, 144, 226, 0.45);
        outline-offset: 2px;
    }

    .plan-text { min-width: 0; line-height: 1.3; }
    .plan-text strong { display: block; font-size: 14.5px; font-weight: 700; color: var(--ink); }
    .plan-text small  { display: block; font-size: 12.5px; color: var(--ink-mute); }

    .plan-check {
        flex: 0 0 auto;
        display: grid;
        place-items: center;
        width: 22px;
        height: 22px;
        margin-left: auto;
        border: 1.5px solid var(--line);
        border-radius: 50%;
        font-size: 12px;
        color: transparent;
        transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }

    .plan-card input:checked + .plan-body .plan-check {
        background: var(--tone);
        border-color: var(--tone);
        color: #fff;
    }

    /* =====================================================
       LIVE PREVIEW CARD
    ===================================================== */
    .preview-panel { padding: 0; }

    .preview-hero {
        position: relative;
        padding: 24px 22px 22px;
        color: #fff;
        background:
            radial-gradient(360px 200px at 0% 0%, rgba(162, 155, 254, 0.28), transparent 60%),
            radial-gradient(320px 200px at 100% 100%, rgba(72, 219, 251, 0.16), transparent 60%),
            linear-gradient(160deg, var(--navy-800) 0%, var(--navy-900) 100%);
    }

    .preview-hero::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 3px;
        background: linear-gradient(90deg, #ff6b6b, #feca57, #48dbfb, #a29bfe, #ff9ff3);
        opacity: 0.85;
    }

    .preview-avatar {
        display: grid;
        place-items: center;
        width: 56px;
        height: 56px;
        border-radius: 16px;
        font-size: 20px;
        font-weight: 800;
        letter-spacing: 0.5px;
        color: #fff;
        background: linear-gradient(135deg, var(--primary), #7b6cf0);
        box-shadow: 0 8px 20px -8px rgba(123, 108, 240, 0.7);
    }

    .preview-name {
        margin: 16px 0 8px;
        font-size: 17px;
        font-weight: 700;
        line-height: 1.25;
        letter-spacing: -0.2px;
        overflow-wrap: anywhere;
    }

    .preview-name.is-empty { color: #8391ad; font-weight: 600; }

    .preview-code {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 3px 11px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        color: #cbd5ea;
        background: rgba(255, 255, 255, 0.10);
    }

    .preview-list { margin: 0; padding: 6px 22px 12px; list-style: none; }

    .preview-list li {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px dashed var(--line);
    }

    .preview-list li:last-child { border-bottom: 0; }

    .preview-list li > i {
        flex: 0 0 auto;
        margin-top: 1px;
        font-size: 16px;
        color: var(--ink-mute);
    }

    .preview-list .lbl { display: block; font-size: 12px; color: var(--ink-mute); }

    .preview-list .val {
        display: block;
        font-size: 13.5px;
        font-weight: 600;
        color: var(--ink);
        overflow-wrap: anywhere;
    }

    .preview-list .val.is-empty { font-weight: 500; color: #b3bdcc; }

    /* =====================================================
       ACTIONS
    ===================================================== */
    .org-actions .panel-body { display: flex; flex-wrap: wrap; gap: 10px; }
    .org-actions .btn { flex: 1 1 auto; }

    @@media (max-width: 575.98px) {
        .org-form .panel-header { padding: 16px; }
        .form-body { padding: 18px 16px; }
        .gst-row { flex-direction: column; }
        #verifyGstBtn { width: 100%; }
        .org-actions .btn { flex: 1 1 100%; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .gst-tick, #verifyGstBtn, .plan-body, .plan-check, .org-form .form-control { transition: none; }
        .auto-filled { animation: none; }
    }
</style>
}

<div class="page-header">
    <div>
        <h1>New Organization</h1>
        <p>Register a new company on the platform</p>
        <div class="page-accent"></div>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back
    </a>
</div>

<form asp-action="Create" method="post" asp-antiforgery="true" autocomplete="off" class="org-form">
    <div asp-validation-summary="ModelOnly"></div>

    <div class="org-layout">

        <!-- ================= MAIN COLUMN ================= -->
        <div class="org-main">

            <!-- ============ SECTION 1: GST VERIFICATION ============ -->
            <section class="panel">
                <div class="panel-header">
                    <span class="icon-tile tone-green"><i class="bi bi-patch-check"></i></span>
                    <div class="panel-title">
                        <h2>GST verification</h2>
                        <p>Verify the GSTIN to fill in the company name, address and city.</p>
                    </div>
                    <span class="pill pill-dot tone-slate ms-auto" id="gstBadge">Not verified</span>
                </div>

                <div class="form-body">
                    <div class="row g-3">
                        <div class="col-lg-8">
                            <div class="d-flex justify-content-between align-items-baseline">
                                <label asp-for="GSTIN" class="form-label">GSTIN</label>
                                <span class="gst-count" id="gstCount">0/15</span>
                            </div>

                            <div class="gst-row">
                                <div class="gst-input-wrap icon-field">
                                    <i class="bi bi-card-text field-icon"></i>
                                    <input asp-for="GSTIN" id="gstinInput" class="form-control"
                                           placeholder="29AAECN1716F1ZM"
                                           style="text-transform:uppercase;"
                                           maxlength="15"
                                           spellcheck="false"
                                           autocomplete="off" />
                                    <span class="gst-tick" id="gstTick">
                                        <i class="bi bi-check-lg"></i>
                                    </span>
                                </div>
                                <button type="button" class="btn btn-primary" id="verifyGstBtn">
                                    <i class="bi bi-search me-1"></i>Verify
                                </button>
                            </div>

                            <span asp-validation-for="GSTIN" class="text-danger field-error"></span>
                            <div id="gstResult" aria-live="polite"></div>
                        </div>

                        <div class="col-lg-4">
                            <label asp-for="Code" class="form-label">
                                Organization Code <span class="label-hint">(auto)</span>
                            </label>
                            <div class="icon-field">
                                <i class="bi bi-hash field-icon"></i>
                                <input asp-for="Code" id="codeInput" class="form-control"
                                       placeholder="ACME-TECH" style="text-transform:uppercase;" />
                            </div>
                            <span asp-validation-for="Code" class="text-danger field-error"></span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ============ SECTIONS 2 + 3: COMPANY + ADDRESS (side by side on wide screens) ============ -->
            <div class="org-pair">

                <!-- ============ SECTION 2: COMPANY DETAILS ============ -->
                <section class="panel">
                    <div class="panel-header">
                        <span class="icon-tile tone-violet"><i class="bi bi-building"></i></span>
                        <div class="panel-title">
                            <h2>Company details</h2>
                            <p>Legal name and contact information</p>
                        </div>
                    </div>

                    <div class="form-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Name" class="form-label">
                                    Legal Name <span class="label-hint">(auto-filled)</span>
                                </label>
                                <div class="icon-field">
                                    <i class="bi bi-briefcase field-icon"></i>
                                    <input asp-for="Name" id="nameInput" class="form-control"
                                           placeholder="ACME TECHNOLOGIES PRIVATE LIMITED" />
                                </div>
                                <span asp-validation-for="Name" class="text-danger field-error"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Email" class="form-label">
                                    Email <span class="label-hint">(suggested)</span>
                                </label>
                                <div class="icon-field">
                                    <i class="bi bi-envelope field-icon"></i>
                                    <input asp-for="Email" id="emailInput" class="form-control"
                                           placeholder="contact@acme.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger field-error"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Phone" class="form-label">Phone</label>
                                <div class="icon-field">
                                    <i class="bi bi-telephone field-icon"></i>
                                    <input asp-for="Phone" id="phoneInput" class="form-control"
                                           placeholder="+91 98xxxxxx" />
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ============ SECTION 3: ADDRESS ============ -->
                <section class="panel">
                    <div class="panel-header">
                        <span class="icon-tile tone-amber"><i class="bi bi-geo-alt"></i></span>
                        <div class="panel-title">
                            <h2>Address</h2>
                            <p>Registered business location</p>
                        </div>
                    </div>

                    <div class="form-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Address" class="form-label">
                                    Full Address <span class="label-hint">(auto-filled)</span>
                                </label>
                                <div class="icon-field">
                                    <i class="bi bi-signpost field-icon"></i>
                                    <input asp-for="Address" id="addressInput" class="form-control"
                                           placeholder="Street, area..." />
                                </div>
                            </div>

                            <div class="col-12">
                                <label asp-for="City" class="form-label">City</label>
                                <div class="icon-field">
                                    <i class="bi bi-geo-alt field-icon"></i>
                                    <input asp-for="City" id="cityInput" class="form-control"
                                           placeholder="Raipur" />
                                </div>
                            </div>

                            <div class="col-12">
                                <label asp-for="Country" class="form-label">Country</label>
                                <div class="icon-field">
                                    <i class="bi bi-globe field-icon"></i>
                                    <input asp-for="Country" id="countryInput" class="form-control"
                                           placeholder="India" value="India" />
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <!-- ============ SECTION 4: PLAN ============ -->
            <section class="panel">
                <div class="panel-header">
                    <span class="icon-tile tone-pink"><i class="bi bi-layers"></i></span>
                    <div class="panel-title">
                        <h2>Plan</h2>
                        <p>Choose the plan for this organization</p>
                    </div>
                </div>

                <div class="form-body">
                    <div class="plan-grid" role="radiogroup" aria-label="Plan">
                        @foreach (var p in plans)
                        {
                            <label class="plan-card tone-@p.Tone">
                                <input type="radio" name="Plan" value="@p.Name" checked="@(selectedPlan == p.Name)" />
                                <span class="plan-body">
                                    <span class="icon-tile"><i class="bi @p.Icon"></i></span>
                                    <span class="plan-text">
                                        <strong>@p.Name</strong>
                                        <small>@p.Desc</small>
                                    </span>
                                    <span class="plan-check"><i class="bi bi-check-lg"></i></span>
                                </span>
                            </label>
                        }
                    </div>
                </div>
            </section>
        </div>

        <!-- ================= SIDE COLUMN ================= -->
        <aside class="org-aside">

            <!-- Live preview (wide screens only) -->
            <section class="panel preview-panel" aria-label="Organization preview">
                <div class="preview-hero">
                    <div class="preview-avatar" id="pvAvatar"><i class="bi bi-building"></i></div>
                    <div class="preview-name is-empty" id="pvName">Organization name</div>
                    <span class="preview-code"><i class="bi bi-hash"></i><span id="pvCode">No code yet</span></span>
                </div>

                <ul class="preview-list">
                    <li>
                        <i class="bi bi-card-text"></i>
                        <div><span class="lbl">GSTIN</span><span class="val is-empty" id="pvGstin">Not provided</span></div>
                    </li>
                    <li>
                        <i class="bi bi-envelope"></i>
                        <div><span class="lbl">Email</span><span class="val is-empty" id="pvEmail">Not provided</span></div>
                    </li>
                    <li>
                        <i class="bi bi-telephone"></i>
                        <div><span class="lbl">Phone</span><span class="val is-empty" id="pvPhone">Not provided</span></div>
                    </li>
                    <li>
                        <i class="bi bi-geo-alt"></i>
                        <div><span class="lbl">Location</span><span class="val is-empty" id="pvLocation">Not provided</span></div>
                    </li>
                    <li>
                        <i class="bi bi-layers"></i>
                        <div><span class="lbl">Plan</span><span class="val" id="pvPlan">@selectedPlan</span></div>
                    </li>
                </ul>
            </section>

            <!-- ============ ACTIONS ============ -->
            <section class="panel org-actions">
                <div class="panel-body">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check2 me-1"></i> Create Organization
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </section>
        </aside>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const $ = (id) => document.getElementById(id);

            const gstinInput = $('gstinInput');
            const verifyBtn  = $('verifyGstBtn');
            const tick       = $('gstTick');
            const resultEl   = $('gstResult');
            const badge      = $('gstBadge');
            const counter    = $('gstCount');
            const wrap       = gstinInput.closest('.gst-input-wrap');

            const VERIFY_HTML = '<i class="bi bi-search me-1"></i>Verify';
            const SKIP_WORDS  = ['private', 'limited', 'pvt', 'ltd', 'llp', 'and', 'the'];

            // ---------- GSTIN input ----------

            // Auto-uppercase GSTIN while typing + reset any previous result
            gstinInput.addEventListener('input', function () {
                this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
                counter.textContent = this.value.length + '/15';

                if (wrap.classList.contains('has-success') || wrap.classList.contains('has-error')) {
                    wrap.classList.remove('has-success', 'has-error');
                    tick.classList.remove('show');
                    resultEl.innerHTML = '';
                    setVerified(false);
                }
            });

            verifyBtn.addEventListener('click', async function () {
                const gstin = gstinInput.value.trim().toUpperCase();

                wrap.classList.remove('has-success', 'has-error', 'is-loading');
                tick.classList.remove('show');
                resultEl.innerHTML = '';
                setVerified(false);

                if (gstin.length !== 15) {
                    wrap.classList.add('has-error');
                    resultEl.innerHTML = '<span class="result-error"><i class="bi bi-x-circle"></i>GSTIN must be exactly 15 characters.</span>';
                    return;
                }

                // Clear values from a previous lookup (GSTIN, Code and Plan are kept)
                clearFields();

                // Loading state
                wrap.classList.add('is-loading');
                verifyBtn.disabled = true;
                verifyBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Checking...';
                resultEl.innerHTML = '<span class="result-loading"><i class="bi bi-hourglass-split"></i>Checking with the GST portal...</span>';

                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    const resp = await fetch('/Organization/LookupGst', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ gstin: gstin })
                    });

                    const data = await resp.json();

                    wrap.classList.remove('is-loading');

                    if (data.success) {
                        // ===== SUCCESS =====
                        wrap.classList.add('has-success');
                        tick.classList.add('show');
                        setVerified(true);

                        const legalName = data.legalName || data.tradeName || '';
                        const status    = data.status || 'Active';

                        resultEl.innerHTML =
                            '<span class="result-success">' +
                            '<i class="bi bi-check-circle-fill"></i>' +
                            '<span><strong>' + escapeHtml(legalName) + '</strong> — ' + escapeHtml(status) + '</span>' +
                            '</span>';

                        // Auto-fill fields with flash animation
                        if (legalName) setField('nameInput', legalName);
                        if (data.address) setField('addressInput', data.address);
                        if (data.city)    setField('cityInput', data.city);
                        setField('countryInput', 'India');

                        // Auto-generate code from name
                        const codeInput = $('codeInput');
                        if (!codeInput.value && legalName) {
                            const short = legalName
                                .split(' ')
                                .filter(w => w.length > 2 && !SKIP_WORDS.includes(w.toLowerCase()))
                                .slice(0, 2)
                                .map(w => w.substring(0, 3).toUpperCase())
                                .join('-');
                            setField('codeInput', short || 'ORG-001');
                        }

                        // Auto-suggest email
                        const emailInput = $('emailInput');
                        if (!emailInput.value && legalName) {
                            const slug = legalName
                                .toLowerCase()
                                .replace(/[^a-z0-9]/g, '')
                                .substring(0, 15);
                            setField('emailInput', 'contact@@' + slug + '.com');
                        }
                    } else {
                        // ===== FAIL =====
                        wrap.classList.add('has-error');
                        resultEl.innerHTML =
                            '<span class="result-error">' +
                            '<i class="bi bi-x-circle"></i>' +
                            escapeHtml(data.error || 'GSTIN not found.') +
                            '</span>';
                    }
                } catch (e) {
                    wrap.classList.remove('is-loading');
                    wrap.classList.add('has-error');
                    resultEl.innerHTML = '<span class="result-error"><i class="bi bi-x-circle"></i>Verification failed. Please try again.</span>';
                } finally {
                    verifyBtn.disabled = false;
                    verifyBtn.innerHTML = VERIFY_HTML;
                    refreshPreview();
                }
            });

            // ---------- HELPERS ----------

            // Clear all auto-fillable fields (not GSTIN or Plan)
            function clearFields() {
                ['nameInput', 'emailInput', 'phoneInput', 'addressInput', 'cityInput', 'codeInput']
                    .forEach(id => { const el = $(id); if (el) el.value = ''; });
                $('countryInput').value = 'India';
                refreshPreview();
            }

            // Set field value + flash animation
            function setField(id, value) {
                const el = $(id);
                if (!el) return;
                el.value = value;
                el.classList.add('auto-filled');
                setTimeout(() => el.classList.remove('auto-filled'), 1000);
            }

            function setVerified(on) {
                badge.classList.toggle('tone-green', on);
                badge.classList.toggle('tone-slate', !on);
                badge.textContent = on ? 'GST verified' : 'Not verified';
            }

            // XSS safe text
            function escapeHtml(str) {
                if (!str) return '';
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            // ---------- LIVE PREVIEW ----------

            function setPreview(id, value, fallback) {
                const el = $(id);
                if (!el) return;
                el.textContent = value || fallback;
                el.classList.toggle('is-empty', !value);
            }

            function initialsOf(name) {
                return name
                    .replace(/[^A-Za-z0-9 ]/g, ' ')
                    .split(/\s+/)
                    .filter(Boolean)
                    .slice(0, 2)
                    .map(w => w[0].toUpperCase())
                    .join('');
            }

            function refreshPreview() {
                const name = $('nameInput').value.trim();
                const ini  = initialsOf(name);
                const av   = $('pvAvatar');

                if (ini) { av.textContent = ini; }
                else     { av.innerHTML = '<i class="bi bi-building"></i>'; }

                setPreview('pvName', name, 'Organization name');
                setPreview('pvCode', $('codeInput').value.trim(), 'No code yet');
                setPreview('pvGstin', gstinInput.value.trim(), 'Not provided');
                setPreview('pvEmail', $('emailInput').value.trim(), 'Not provided');
                setPreview('pvPhone', $('phoneInput').value.trim(), 'Not provided');

                const location = [$('addressInput').value, $('cityInput').value, $('countryInput').value]
                    .map(v => v.trim())
                    .filter(Boolean)
                    .join(', ');
                setPreview('pvLocation', location, 'Not provided');

                const plan = document.querySelector('input[name="Plan"]:checked');
                if (plan) $('pvPlan').textContent = plan.value;
            }

            ['gstinInput', 'codeInput', 'nameInput', 'emailInput', 'phoneInput', 'addressInput', 'cityInput', 'countryInput']
                .forEach(id => $(id).addEventListener('input', refreshPreview));

            document.querySelectorAll('input[name="Plan"]')
                .forEach(r => r.addEventListener('change', refreshPreview));

            // Initial state (also covers a re-render after server-side validation errors)
            counter.textContent = gstinInput.value.length + '/15';
            refreshPreview();
        })();
    </script>
}
