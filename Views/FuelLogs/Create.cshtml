@model ERPDemo.Models.FuelLog
@{
    ViewData["Title"] = "Add Fuel Log";
    Layout = "_DashboardLayout";
    var vehicles = ViewBag.Vehicles as List<ERPDemo.Models.Vehicle> ?? new();
}

<div class="rt-page">

    <div class="rt-head">
        <div>
            <h1>Add Fuel Log</h1>
            <p>Record fuel fill-up</p>
        </div>
        <a asp-action="Index" class="rt-btn"><i class="bi bi-arrow-left me-1"></i> Back</a>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="rt-alert rt-alert-error mb-3"></div>

        <section class="rt-window">
            <div class="rt-titlebar">
                <span><i class="bi bi-fuel-pump me-2"></i>Fuel Details</span>
            </div>
            <div class="p-3 row g-3">
                <div class="col-md-6">
                    <label class="rt-label">Vehicle *</label>
                    <select name="VehicleId" class="rt-input" required>
                        <option value="">-- Select Vehicle --</option>
                        @foreach (var v in vehicles)
                        {
                            <option value="@v.VehicleId" selected="@(Model.VehicleId == v.VehicleId)">
                                @v.RegistrationNumber — @v.VehicleType
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="rt-label">Filled At *</label>
                    <input name="FilledAt" type="datetime-local" class="rt-input" required
                           value="@Model.FilledAt.ToString("yyyy-MM-ddTHH:mm")" />
                </div>
                <div class="col-md-4">
                    <label class="rt-label">Liters *</label>
                    <input name="Liters" type="number" step="0.1" class="rt-input" required
                           value="@Model.Liters" placeholder="e.g. 60.5" />
                </div>
                <div class="col-md-4">
                    <label class="rt-label">Amount (₹) *</label>
                    <input name="Amount" type="number" step="1" class="rt-input" required
                           value="@Model.Amount" placeholder="e.g. 5500" />
                </div>
                <div class="col-md-4">
                    <label class="rt-label">Odometer (km)</label>
                    <input name="OdometerKm" type="number" step="1" class="rt-input"
                           value="@Model.OdometerKm" placeholder="e.g. 86180" />
                </div>
                <div class="col-md-6">
                    <label class="rt-label">Fuel Station</label>
                    <input name="FuelStation" class="rt-input" value="@Model.FuelStation"
                           placeholder="Indian Oil, HP, BPCL..." />
                </div>
            </div>
        </section>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="rt-btn rt-btn-primary">
                <i class="bi bi-check-circle me-1"></i> Save Fuel Log
            </button>
            <a asp-action="Index" class="rt-btn">Cancel</a>
        </div>
    </form>
</div>