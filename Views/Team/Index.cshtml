@model ERPDemo.ViewModels.TeamViewModel
@{
    ViewData["Title"] = "My Team";
    Layout = "_DashboardLayout";
    var currentId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="page-header">
    <div class="header-left">
        <a asp-controller="Dashboard" asp-action="Index" class="back-btn" title="Back to Dashboard">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h1>My Team</h1>
            <p>Manage your organization's users</p>
            <div class="page-accent"></div>
        </div>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus me-1"></i> Add Member
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card tone-sky">
            <div>
                <span class="stat-label">Total Members</span>
                <span class="stat-value">@Model.TotalMembers</span>
                <span class="stat-note">In your organization</span>
            </div>
            <span class="icon-tile"><i class="bi bi-people"></i></span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card tone-green">
            <div>
                <span class="stat-label">Active</span>
                <span class="stat-value">@Model.ActiveMembers</span>
                <span class="stat-note">Currently working</span>
            </div>
            <span class="icon-tile"><i class="bi bi-person-check"></i></span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card tone-amber">
            <div>
                <span class="stat-label">Managers</span>
                <span class="stat-value">@Model.ManagerCount</span>
                <span class="stat-note">Team leads</span>
            </div>
            <span class="icon-tile"><i class="bi bi-person-workspace"></i></span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card tone-violet">
            <div>
                <span class="stat-label">Employees</span>
                <span class="stat-value">@Model.UserCount</span>
                <span class="stat-note">Team members</span>
            </div>
            <span class="icon-tile"><i class="bi bi-person"></i></span>
        </div>
    </div>
</div>

<!-- Filters -->
<form method="get" class="mb-3">
    <div class="row g-2">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control"
                       placeholder="Search by name, username or email..." />
            </div>
        </div>
        <div class="col-md-3">
            <select name="role" class="form-select">
                <option value="">All roles</option>
                <option value="User"    selected="@(Model.RoleFilter == "User")">Employees</option>
                <option value="Manager" selected="@(Model.RoleFilter == "Manager")">Managers</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select">
                <option value="">All statuses</option>
                <option value="active"   selected="@(Model.StatusFilter == "active")">Active</option>
                <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Inactive</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button class="btn btn-primary flex-fill" type="submit">Apply</button>
            @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.RoleFilter) || !string.IsNullOrEmpty(Model.StatusFilter))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            }
        </div>
    </div>
</form>

<!-- Table -->
<section class="panel">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Member</th>
                    <th>Role</th>
                    <th>Last Login</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Members)
                {
                    var isSelf = m.UserId.ToString() == currentId;
                    var canManage = m.RoleName == "User" || m.RoleName == "Manager";
                    var roleBadge = m.RoleName switch
                    {
                        "Admin" => "bg-warning text-dark",
                        "Manager" => "bg-info text-dark",
                        _ => "bg-secondary"
                    };

                    <tr>
                        <td>
                            <div class="user-cell">
                                <span class="avatar tone-sky">
                                    @(m.FullName?.Substring(0, 1).ToUpper() ?? m.Username.Substring(0, 1).ToUpper())
                                </span>
                                <div class="meta">
                                    <span class="user-name-text">
                                        @(m.FullName ?? m.Username)
                                        @if (isSelf) { <span class="badge bg-primary-subtle text-primary ms-1" style="font-size:10px;">You</span> }
                                    </span>
                                    <span class="user-email">@m.Email</span>
                                </div>
                            </div>
                        </td>
                        <td><span class="badge @roleBadge">@m.RoleName</span></td>
                        <td>@(m.LastLoginAt?.ToString("MMM dd, HH:mm") ?? "Never")</td>
                        <td>
                            @if (m.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                @if (canManage)
                                {
                                    <a asp-action="Edit" asp-route-id="@m.UserId" class="btn btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="ResetPassword" asp-route-id="@m.UserId" class="btn btn-outline-info" title="Reset Password">
                                        <i class="bi bi-key"></i>
                                    </a>

                                    @if (!isSelf)
                                    {
                                        <form asp-action="ToggleActive" asp-route-id="@m.UserId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-outline-warning" title="@(m.IsActive ? "Deactivate" : "Activate")">
                                                <i class="bi bi-@(m.IsActive ? "toggle-on" : "toggle-off")"></i>
                                            </button>
                                        </form>

                                        <form asp-action="Delete" asp-route-id="@m.UserId" method="post" class="d-inline"
                                              onsubmit="return confirm('Delete @m.Username? Ye undo nahi hoga.');">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small px-2">Protected</span>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Members.Any())
                {
                    <tr>
                        <td colspan="5">
                            <div class="empty-state">
                                <i class="bi bi-people"></i>
                                <strong>No team members found</strong>
                                <span>Add your first team member to get started.</span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>