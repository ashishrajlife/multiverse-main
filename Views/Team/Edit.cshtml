@model ERPDemo.ViewModels.EditTeamMemberViewModel
@{
    ViewData["Title"] = "Edit Team Member";
    Layout = "_DashboardLayout";
    var roles = ViewBag.Roles as List<ERPDemo.Models.Role> ?? new();
}

<div class="rt-head">
    <div class="rt-head-left">
        <!-- Back button rerouted to ManageAll -->
        <a asp-action="ManageAll" class="rt-btn rt-btn-back" title="Back to Manage All">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h1>Edit Team Member</h1>
            <p>Update user details and role</p>
        </div>
    </div>
</div>

<div class="rt-window" style="max-width: 720px;">
    <div class="rt-titlebar"><span>Update Details</span></div>
    <div class="p-4">
        <form asp-action="Edit" method="post" asp-antiforgery="true">
            <input type="hidden" asp-for="UserId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Username" class="form-label fw-semibold" style="font-size:13px;">Username</label>
                    <input asp-for="Username" class="rt-field w-100" />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-semibold" style="font-size:13px;">Email</label>
                    <input asp-for="Email" class="rt-field w-100" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label fw-semibold" style="font-size:13px;">Full Name</label>
                    <input asp-for="FullName" class="rt-field w-100" />
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label fw-semibold" style="font-size:13px;">Phone</label>
                    <input asp-for="PhoneNumber" class="rt-field w-100" />
                </div>
                <div class="col-md-6">
                    <label asp-for="RoleId" class="form-label fw-semibold" style="font-size:13px;">Role</label>
                    <select asp-for="RoleId" class="rt-field w-100">
                        @foreach (var r in roles)
                        {
                            <option value="@r.RoleId" selected="@(r.RoleId == Model.RoleId)">@r.RoleName</option>
                        }
                    </select>
                    <span asp-validation-for="RoleId" class="text-danger small"></span>
                </div>
                <div class="col-md-6 d-flex align-items-center pt-4">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold" style="font-size:13px;">Active</label>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="rt-btn rt-btn-primary">
                    <i class="bi bi-check2 me-1"></i> Save Changes
                </button>
                <a asp-action="ManageAll" class="rt-btn">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}