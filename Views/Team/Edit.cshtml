@model ERPDemo.ViewModels.EditTeamMemberViewModel
@{
    ViewData["Title"] = "Edit Team Member";
    Layout = "_DashboardLayout";
    var roles = ViewBag.Roles as List<ERPDemo.Models.Role> ?? new();
    var departments = ViewBag.Departments as List<ERPDemo.Models.Department> ?? new();
}

<div class="rt-head">
    <div class="rt-head-left">
        <a asp-action="ManageAll" class="rt-btn rt-btn-back" title="Back">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h1>Edit Team Member</h1>
            <p>Update user information, assignments, and activation status</p>
        </div>
    </div>
</div>

<div class="rt-window" style="max-width: 800px;">
    <div class="rt-titlebar"><span>Edit Member Profile</span></div>
    <div class="p-4">
        <form asp-action="Edit" method="post" asp-antiforgery="true">
            <input type="hidden" asp-for="UserId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Username" class="form-label fw-semibold" style="font-size:13px;">Username</label>
                    <input asp-for="Username" class="rt-field w-100" />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-semibold" style="font-size:13px;">Email Address</label>
                    <input asp-for="Email" class="rt-field w-100" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label fw-semibold" style="font-size:13px;">Full Name</label>
                    <input asp-for="FullName" class="rt-field w-100" />
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label fw-semibold" style="font-size:13px;">Phone Number</label>
                    <input asp-for="PhoneNumber" class="rt-field w-100" />
                </div>
                <div class="col-md-6">
                    <label asp-for="RoleId" class="form-label fw-semibold" style="font-size:13px;">System Role</label>
                    <select asp-for="RoleId" class="rt-field w-100">
                        @foreach (var r in roles)
                        {
                            <option value="@r.RoleId" selected="@(r.RoleId == Model.RoleId)">@r.RoleName</option>
                        }
                    </select>
                    <span asp-validation-for="RoleId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DepartmentId" class="form-label fw-semibold" style="font-size:13px;">Department</label>
                    <select asp-for="DepartmentId" class="rt-field w-100">
                        <option value="">-- None --</option>
                        @foreach (var d in departments)
                        {
                            <option value="@d.DepartmentId" selected="@(d.DepartmentId == Model.DepartmentId)">@d.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-12 pt-2">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold" style="font-size:13px;">Active Account Status</label>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="rt-btn rt-btn-primary">
                    <i class="bi bi-check2 me-1"></i> Update Changes
                </button>
                <a asp-action="ManageAll" class="rt-btn">Cancel</a>
            </div>
            <hr class="my-4" />
<h6 class="fw-bold text-primary mb-3"><i class="bi bi-person-vcard me-1"></i> Personal & Contact Details</h6>
<div class="row g-3">
    <div class="col-md-12">
        <label asp-for="Address" class="form-label fw-semibold" style="font-size:13px;">Address</label>
        <input asp-for="Address" class="rt-field w-100" placeholder="Street, Area, Landmark" />
    </div>
    <div class="col-md-4">
        <label asp-for="City" class="form-label fw-semibold" style="font-size:13px;">City</label>
        <input asp-for="City" class="rt-field w-100" value="Raipur" />
    </div>
    <div class="col-md-4">
        <label asp-for="State" class="form-label fw-semibold" style="font-size:13px;">State</label>
        <input asp-for="State" class="rt-field w-100" value="Chhattisgarh" />
    </div>
    <div class="col-md-4">
        <label asp-for="Pincode" class="form-label fw-semibold" style="font-size:13px;">Pincode</label>
        <input asp-for="Pincode" class="rt-field w-100" placeholder="492001" />
    </div>
    <div class="col-md-6">
        <label asp-for="AadhaarNumber" class="form-label fw-semibold" style="font-size:13px;">Aadhaar Number</label>
        <input asp-for="AadhaarNumber" class="rt-field w-100" placeholder="XXXX XXXX XXXX" />
    </div>
    <div class="col-md-6">
        <label asp-for="PanNumber" class="form-label fw-semibold" style="font-size:13px;">PAN Number</label>
        <input asp-for="PanNumber" class="rt-field w-100" placeholder="ABCDE1234F" />
    </div>
</div>

<hr class="my-4" />
<h6 class="fw-bold text-primary mb-3"><i class="bi bi-briefcase me-1"></i> Employment & Shift Details</h6>
<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="EmploymentType" class="form-label fw-semibold" style="font-size:13px;">Employment Type</label>
        <select asp-for="EmploymentType" class="rt-field w-100">
            <option value="">-- Select --</option>
            <option value="Permanent">Permanent</option>
            <option value="Contractual">Contractual</option>
            <option value="Vendor">Vendor</option>
            <option value="Apprentice">Apprentice</option>
        </select>
    </div>
    <div class="col-md-4">
        <label asp-for="Designation" class="form-label fw-semibold" style="font-size:13px;">Designation</label>
        <input asp-for="Designation" class="rt-field w-100" placeholder="e.g. Plant Supervisor" />
    </div>
    <div class="col-md-4">
        <label asp-for="PlantLocation" class="form-label fw-semibold" style="font-size:13px;">Plant Location</label>
        <select asp-for="PlantLocation" class="rt-field w-100">
            <option value="">-- Select --</option>
            <option value="Raipur - Main Plant">Raipur - Main Plant</option>
            <option value="Siltara Industrial Area">Siltara Industrial Area</option>
            <option value="Urla Industrial Area">Urla Industrial Area</option>
            <option value="Bhilai">Bhilai</option>
        </select>
    </div>
    <div class="col-md-4">
        <label asp-for="JoiningDate" class="form-label fw-semibold" style="font-size:13px;">Joining Date</label>
        <input asp-for="JoiningDate" type="date" class="rt-field w-100" />
    </div>
    <div class="col-md-4">
        <label asp-for="ShiftStartTime" class="form-label fw-semibold" style="font-size:13px;">Shift Start Time</label>
        <input asp-for="ShiftStartTime" type="time" class="rt-field w-100" />
    </div>
    <div class="col-md-4">
        <label asp-for="ShiftEndTime" class="form-label fw-semibold" style="font-size:13px;">Shift End Time</label>
        <input asp-for="ShiftEndTime" type="time" class="rt-field w-100" />
    </div>
    <div class="col-md-6">
        <label asp-for="SalaryType" class="form-label fw-semibold" style="font-size:13px;">Salary Type</label>
        <select asp-for="SalaryType" class="rt-field w-100">
            <option value="">-- Select --</option>
            <option value="Monthly">Monthly</option>
            <option value="Daily">Daily</option>
            <option value="Hourly">Hourly</option>
        </select>
    </div>
    <div class="col-md-6">
        <label asp-for="SalaryAmount" class="form-label fw-semibold" style="font-size:13px;">Salary Amount (₹)</label>
        <input asp-for="SalaryAmount" type="number" step="0.01" class="rt-field w-100" placeholder="e.g. 25000" />
    </div>
</div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}