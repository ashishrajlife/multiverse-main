@model ERPDemo.ViewModels.CreateTeamMemberViewModel
@{
    ViewData["Title"] = "Add Team Member";
    Layout = "_DashboardLayout";
    var roles = ViewBag.Roles as List<ERPDemo.Models.Role> ?? new();
}

<div class="rt-head">
    <div class="rt-head-left">
        <!-- Back button rerouted to ManageAll -->
        <a asp-action="ManageAll" class="rt-btn rt-btn-back" title="Back to Manage All">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h1>Add Team Member</h1>
            <p>Create a new user in your organization</p>
        </div>
    </div>
</div>

<div class="rt-window" style="max-width: 720px;">
    <div class="rt-titlebar"><span>Member Details</span></div>
    <div class="p-4">
        <form asp-action="Create" method="post" asp-antiforgery="true">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Username" class="form-label fw-semibold" style="font-size:13px;">Username</label>
                    <input asp-for="Username" class="rt-field w-100" placeholder="john.doe" />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-semibold" style="font-size:13px;">Email</label>
                    <input asp-for="Email" class="rt-field w-100" placeholder="john@company.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label fw-semibold" style="font-size:13px;">Full Name</label>
                    <input asp-for="FullName" class="rt-field w-100" placeholder="John Doe" />
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label fw-semibold" style="font-size:13px;">Phone</label>
                    <input asp-for="PhoneNumber" class="rt-field w-100" placeholder="+91 98xxxxxx" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label fw-semibold" style="font-size:13px;">Password</label>
                    <input asp-for="Password" type="password" class="rt-field w-100" placeholder="Min 4 characters" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="RoleId" class="form-label fw-semibold" style="font-size:13px;">Role</label>
                    <select asp-for="RoleId" class="rt-field w-100">
                        <option value="">-- Select role --</option>
                        @foreach (var r in roles)
                        {
                            <option value="@r.RoleId">@r.RoleName</option>
                        }
                    </select>
                    <span asp-validation-for="RoleId" class="text-danger small"></span>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="rt-btn rt-btn-primary">
                    <i class="bi bi-check2 me-1"></i> Add Member
                </button>
                <a asp-action="ManageAll" class="rt-btn">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}