@model List<ERPDemo.Models.User>
@{
    ViewData["Title"] = "Manage Team";
    Layout = "_DashboardLayout";
    var roles = ViewBag.Roles as List<ERPDemo.Models.Role> ?? new();
}

<div class="rt-page">
    <div class="rt-head">
        <div>
            <h1>Manage Team</h1>
            <p>@Model.Count user(s)</p>
        </div>
        <a asp-action="Create" class="rt-btn rt-btn-primary">
            <i class="bi bi-person-plus me-1"></i> Add User
        </a>
    </div>

    <form method="get" class="rt-filter-bar">
        <input type="text" name="search" value="@ViewBag.Search" placeholder="Search name / email / username..." class="rt-input" style="max-width:280px;" />
        <select name="roleId" class="rt-input" style="max-width:160px;">
            <option value="">All Roles</option>
            @foreach (var r in roles)
            {
                <option value="@r.RoleId" selected="@(ViewBag.RoleId == r.RoleId)">@r.RoleName</option>
            }
        </select>
        <button type="submit" class="rt-btn rt-btn-primary"><i class="bi bi-search me-1"></i> Filter</button>
        <a asp-action="ManageAll" class="rt-btn">Clear</a>
    </form>

    <section class="rt-window mt-3">
        <div class="rt-scroll">
            <table class="rt-table rt-table-vehicles" style="width:100%; table-layout:fixed;">
                <colgroup>
                    <col style="width: 20%;" />
                    <col style="width: 20%;" />
                    <col style="width: 12%;" />
                    <col style="width: 15%;" />
                    <col style="width: 10%;" />
                    <col style="width: 23%;" />
                </colgroup>
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Department</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>
                            <div class="rt-user" style="justify-content:center;">
                                <span class="rt-avatar rt-sky"><i class="bi bi-person"></i></span>
                                <span class="rt-user-name">@u.FullName</span>
                            </div>
                        </td>
                        <td>@u.Email</td>
                        <td><span class="rt-tag rt-nodot">@u.Role?.RoleName</span></td>
                        <td>@(u.Department?.Name ?? "—")</td>
                        <td>
                            @if (u.IsActive) { <span class="rt-tag rt-green">Active</span> }
                            else { <span class="rt-tag rt-coral">Inactive</span> }
                        </td>
                        <td>
                            <div class="rt-action-group">
                                <form asp-action="ToggleActive" asp-route-id="@u.UserId" method="post"
                                    onsubmit="return confirm('@(u.IsActive ? "Deactivate" : "Activate") @u.FullName?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="rt-btn rt-btn-sm @(u.IsActive ? "rt-btn-warn" : "rt-btn-success")" title="Toggle">
                                        <i class="bi @(u.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                    </button>
                                </form>
                                <a asp-action="Edit" asp-route-id="@u.UserId" class="rt-btn rt-btn-sm" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                @if (!u.IsActive)
                                {
                                    <form asp-action="Delete" asp-route-id="@u.UserId" method="post"
                                        onsubmit="return confirm('Permanently delete @u.FullName? This cannot be undone.');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="rt-btn rt-btn-sm rt-btn-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>