@model ERPDemo.ViewModels.ManageAllViewModel
@{
    ViewData["Title"] = "Manage All";
    Layout = "_DashboardLayout";
}

@section Styles {
<link rel="stylesheet" href="~/css/retro.css" asp-append-version="true" />
}

<div class="rt-page">

<div class="rt-head">
    <div class="rt-head-left">
        <a asp-controller="Dashboard" asp-action="Index" class="rt-btn rt-btn-icon rt-btn-back" title="Back">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h1>Manage All</h1>
            <p>Change roles and departments instantly</p>
        </div>
    </div>
    <a asp-action="Create" class="rt-btn rt-btn-primary">
        <i class="bi bi-person-plus"></i> Add Member
    </a>
</div>

<!-- KPI strip -->
<div class="rt-stats">
    <div class="rt-stat rt-sky">
        <span class="rt-stat-icon"><i class="bi bi-people"></i></span>
        <div>
            <span class="rt-stat-label">Total members</span>
            <span class="rt-stat-value">@Model.TotalMembers</span>
        </div>
    </div>
    <div class="rt-stat rt-amber">
        <span class="rt-stat-icon"><i class="bi bi-person-workspace"></i></span>
        <div>
            <span class="rt-stat-label">Managers</span>
            <span class="rt-stat-value">@Model.ManagerCount</span>
        </div>
    </div>
    <div class="rt-stat rt-violet">
        <span class="rt-stat-icon"><i class="bi bi-person"></i></span>
        <div>
            <span class="rt-stat-label">Employees</span>
            <span class="rt-stat-value">@Model.EmployeeCount</span>
        </div>
    </div>
    <div class="rt-stat rt-green">
        <span class="rt-stat-icon"><i class="bi bi-person-check"></i></span>
        <div>
            <span class="rt-stat-label">Active</span>
            <span class="rt-stat-value">@Model.ActiveCount</span>
        </div>
    </div>
</div>

<!-- Filters -->
<form method="get" class="rt-filter">
    <i class="bi bi-funnel rt-filter-icon" aria-hidden="true"></i>

    <div class="rt-search">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="text" name="search" value="@Model.SearchTerm" class="rt-field"
               placeholder="Name, username or email" aria-label="Search members" />
    </div>

    <select name="role" class="rt-field" aria-label="Role">
        <option value="">All roles</option>
        <option value="manager"  selected="@(Model.RoleFilter == "manager")">Managers</option>
        <option value="employee" selected="@(Model.RoleFilter == "employee")">Employees</option>
    </select>

    <select name="department" class="rt-field" aria-label="Department">
        <option value="">All departments</option>
        @foreach (var d in Model.Departments)
        {
            <option value="@d.DepartmentId" selected="@(Model.DepartmentFilter == d.DepartmentId.ToString())">@d.Name</option>
        }
    </select>

    <select name="status" class="rt-field" aria-label="Status">
        <option value="">All statuses</option>
        <option value="active"   selected="@(Model.StatusFilter == "active")">Active</option>
        <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Inactive</option>
    </select>

    <button class="rt-btn rt-btn-primary" type="submit">Apply</button>
    @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.RoleFilter) || !string.IsNullOrEmpty(Model.DepartmentFilter) || !string.IsNullOrEmpty(Model.StatusFilter))
    {
        <a asp-action="ManageAll" class="rt-btn">Clear</a>
    }
</form>

<!-- Table -->
<section class="rt-window">
    <div class="rt-titlebar">
        <span><i class="bi bi-table me-2"></i>Member list</span>
    </div>

    <div class="rt-scroll">
        <table class="rt-table">
            <thead>
                <tr>
                    <th>Member</th>
                    <th>Department</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Last login</th>
                    <th class="rt-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Members)
                {
                    var isManager = m.RoleName == "Manager";
                    var initials = !string.IsNullOrEmpty(m.FullName)
                        ? m.FullName.Substring(0, 1).ToUpper()
                        : m.Username.Substring(0, 1).ToUpper();

                    <tr data-user-id="@m.UserId">
                        <td>
                            <div class="rt-user">
                                <span class="rt-avatar rt-sky">@initials</span>
                                <div>
                                    <span class="rt-user-name">@(m.FullName ?? m.Username)</span>
                                    <span class="rt-user-email">@m.Email</span>
                                </div>
                            </div>
                        </td>

                        <td>
                            <select class="dept-select" data-user-id="@m.UserId" data-original="@(m.DepartmentId?.ToString() ?? "")">
                                <option value="">— None —</option>
                                @foreach (var d in Model.Departments)
                                {
                                    <option value="@d.DepartmentId" selected="@(m.DepartmentId == d.DepartmentId)">@d.Name</option>
                                }
                            </select>
                        </td>

                        <td>
                            <div class="role-toggle @(isManager ? "is-manager" : "")"
                                 data-user-id="@m.UserId"
                                 data-role="@(isManager ? "manager" : "employee")"
                                 role="button"
                                 tabindex="0"
                                 title="Click to switch role">
                                <span class="knob">
                                    <i class="bi @(isManager ? "bi-person-workspace" : "bi-person")"></i>
                                </span>
                                <span class="role-label">@(isManager ? "Manager" : "Employee")</span>
                            </div>
                        </td>

                        <td>
                            @if (m.IsActive)
                            {
                                <span class="rt-tag rt-green">Active</span>
                            }
                            else
                            {
                                <span class="rt-tag rt-coral">Inactive</span>
                            }
                        </td>

                        <td>@(m.LastLoginAt?.ToString("MMM dd, HH:mm") ?? "Never")</td>

                        <td class="rt-right">
                            <div class="rt-actions">
                                <a asp-action="Edit" asp-route-id="@m.UserId" class="rt-btn rt-btn-icon rt-i-edit" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="ResetPassword" asp-route-id="@m.UserId" class="rt-btn rt-btn-icon rt-i-key" title="Reset password">
                                    <i class="bi bi-key"></i>
                                </a>
                           <form asp-action="ToggleActive" asp-route-id="@m.UserId" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="search"     value="@Model.SearchTerm" />
                            <input type="hidden" name="role"       value="@Model.RoleFilter" />
                            <input type="hidden" name="department" value="@Model.DepartmentFilter" />
                            <input type="hidden" name="status"     value="@Model.StatusFilter" />
                            <button class="rt-btn rt-btn-icon rt-i-warn" title="@(m.IsActive ? "Deactivate" : "Activate")">
                                <i class="bi bi-@(m.IsActive ? "toggle-on" : "toggle-off")"></i>
                            </button>
                        </form>
                              <form asp-action="Delete" asp-route-id="@m.UserId" method="post"
                                onsubmit="return confirm('Delete @m.Username? Ye undo nahi hoga.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="search"     value="@Model.SearchTerm" />
                                <input type="hidden" name="role"       value="@Model.RoleFilter" />
                                <input type="hidden" name="department" value="@Model.DepartmentFilter" />
                                <input type="hidden" name="status"     value="@Model.StatusFilter" />
                                <button class="rt-btn rt-btn-icon rt-i-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Members.Any())
                {
                    <tr>
                        <td colspan="6">
                            <div class="rt-empty">
                                <i class="bi bi-people"></i>
                                <strong>No members found</strong>
                                <span>Try different filters or add a member.</span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="rt-statusbar">
        <span>Showing @Model.Members.Count() of @Model.TotalMembers members</span>
        <span>Click a role to switch it. Department saves on change.</span>
    </div>
</section>

<!-- Toast -->
<div class="toast-note" id="toastNote">
    <i class="bi bi-check-circle"></i>
    <span id="toastMessage"></span>
</div>

</div>

@section Scripts {
<script>
    (function () {
        // ---------- Toast helper ----------
        const toast = document.getElementById('toastNote');
        const toastMsg = document.getElementById('toastMessage');
        let toastTimeout;

        function showToast(message, type) {
            toastMsg.textContent = message;
            toast.className = 'toast-note ' + (type || 'success');
            toast.classList.add('show');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => toast.classList.remove('show'), 2500);
        }

        // ---------- Get anti-forgery token ----------
        function getToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]').value;
        }

        // ---------- Role toggle ----------
        document.querySelectorAll('.role-toggle').forEach(function (el) {
            el.addEventListener('click', async function () {
                if (this.classList.contains('is-loading')) return;

                const userId = this.dataset.userId;
                const originalState = this.dataset.role;
                const newState = originalState === 'manager' ? 'employee' : 'manager';

                // Optimistic UI update
                this.classList.add('is-loading');

                try {
                    const resp = await fetch('/Team/ToggleRole', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': getToken()
                        },
                        body: JSON.stringify({ userId: parseInt(userId) })
                    });

                    const data = await resp.json();

                    if (data.success) {
                        // Update UI
                        this.dataset.role = newState;
                        this.classList.toggle('is-manager', newState === 'manager');
                        this.querySelector('.knob i').className =
                            newState === 'manager' ? 'bi bi-person-workspace' : 'bi bi-person';
                        this.querySelector('.role-label').textContent =
                            newState === 'manager' ? 'Manager' : 'Employee';

                        showToast(data.message || 'Role updated', 'success');
                    } else {
                        showToast(data.error || 'Update failed', 'error');
                    }
                } catch (e) {
                    showToast('Network error. Try again.', 'error');
                } finally {
                    this.classList.remove('is-loading');
                }
            });
        });

        // Keyboard support for the role toggle
        document.querySelectorAll('.role-toggle').forEach(function (el) {
            el.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    el.click();
                }
            });
        });

        // ---------- Department change ----------
        document.querySelectorAll('.dept-select').forEach(function (el) {
            el.addEventListener('change', async function () {
                const userId = this.dataset.userId;
                const deptId = this.value;
                const original = this.dataset.original || '';

                try {
                    const resp = await fetch('/Team/UpdateDepartment', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': getToken()
                        },
                        body: JSON.stringify({
                            userId: parseInt(userId),
                            departmentId: deptId ? parseInt(deptId) : null
                        })
                    });

                    const data = await resp.json();

                    if (data.success) {
                        this.dataset.original = deptId;
                        showToast('Department updated', 'success');
                    } else {
                        // Revert
                        this.value = original;
                        showToast(data.error || 'Update failed', 'error');
                    }
                } catch (e) {
                    this.value = original;
                    showToast('Network error. Try again.', 'error');
                }
            });
        });
    })();
</script>
}