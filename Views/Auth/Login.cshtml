@model ERPDemo.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ERP Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        * { box-sizing: border-box; }

        html, body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
        }

        /* ---------- GREENER MAP BACKGROUND ---------- */
        .login-wrapper {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 16px;
            overflow: hidden;
            background: #e8f3e2;
        }

        .map-bg {
            position: absolute;
            inset: 0;
            z-index: 0;
            background:
                radial-gradient(circle at 15% 20%, #cfe8c2 0%, transparent 45%),
                radial-gradient(circle at 85% 25%, #d3ecc6 0%, transparent 50%),
                radial-gradient(circle at 25% 80%, #d5ebc9 0%, transparent 45%),
                radial-gradient(circle at 80% 85%, #c9e6bd 0%, transparent 50%),
                linear-gradient(135deg, #eaf5e2 0%, #d9ead1 100%);
        }

        .map-bg svg {
            width: 100%;
            height: 100%;
            display: block;
        }

        /* ---------- FLOATING ICONS ---------- */
        .map-icon {
            position: absolute;
            z-index: 2;
            pointer-events: none;
            filter: drop-shadow(0 4px 8px rgba(30, 60, 30, 0.18));
            animation: floatY 6s ease-in-out infinite;
        }

        @@keyframes floatY {
            0%, 100% { transform: translateY(0); }
            50%      { transform: translateY(-4px); }
        }

        /* Icon variants */
        .ic-pin     { color: #4A90E2; font-size: 26px; }
        .ic-truck   { color: #6b7c8a; font-size: 30px; }
        .ic-package { color: #d99e2b; font-size: 24px; }
        .ic-person  { color: #3f7fb0; font-size: 26px; }
        .ic-work    { color: #55697c; font-size: 26px; }
        .ic-laptop  { color: #4c5f73; font-size: 28px; }
        .ic-phone   { color: #55697c; font-size: 22px; }

        /* Positions */
        .ic-1  { top: 10%; left: 8%; }
        .ic-2  { top: 20%; left: 18%; animation-delay: 1s; }
        .ic-3  { bottom: 16%; left: 10%; animation-delay: 2s; }
        .ic-4  { bottom: 28%; left: 22%; animation-delay: 0.5s; }
        .ic-5  { top: 14%; right: 12%; animation-delay: 1.5s; }
        .ic-6  { top: 26%; right: 22%; animation-delay: 2.5s; }
        .ic-7  { bottom: 20%; right: 14%; animation-delay: 0.8s; }
        .ic-8  { bottom: 30%; right: 24%; animation-delay: 1.8s; }
        .ic-9  { top: 40%; left: 5%; }
        .ic-10 { top: 55%; right: 6%; animation-delay: 1.2s; }
        .ic-11 { top: 70%; left: 18%; animation-delay: 0.4s; }
        .ic-12 { top: 8%;  right: 32%; animation-delay: 2.2s; }

        /* ---------- LOGIN CARD ---------- */

        /* ---------- BRAND HEADER ---------- */
        .brand-header {
            text-align: center;
            margin-bottom: 28px;
        }

        .brand-title {
            font-size: 34px;
            font-weight: 800;
            letter-spacing: -0.5px;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            line-height: 1.1;
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
        }

        /* Multicolor gradient text */
        .brand-text {
            background: linear-gradient(
                90deg,
                #ff6b6b 0%,
                #feca57 25%,
                #48dbfb 50%,
                #a29bfe 75%,
                #ff9ff3 100%
            );
            background-size: 200% auto;
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            color: transparent;
            animation: shimmer 4s linear infinite;
            text-shadow: 0 0 30px rgba(255, 255, 255, 0.06);
        }

        @@keyframes shimmer {
            0%   { background-position: 0% center; }
            100% { background-position: 200% center; }
        }

        /* Infinity sign — bigger, glowing, cycled gradient */
        .brand-infinity {
            font-size: 44px;
            font-weight: 700;
            line-height: 1;
            display: inline-block;
            background: linear-gradient(
                120deg,
                #48dbfb 0%,
                #a29bfe 50%,
                #ff9ff3 100%
            );
            background-size: 200% auto;
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            color: transparent;
            animation: shimmer 4s linear infinite, pulse 3s ease-in-out infinite;
            transform: translateY(-2px);
            filter: drop-shadow(0 0 12px rgba(162, 155, 254, 0.45));
        }

        @@keyframes pulse {
            0%, 100% { transform: translateY(-2px) scale(1); }
            50%      { transform: translateY(-2px) scale(1.08); }
        }

        /* Divider under brand */
        .brand-divider {
            width: 60px;
            height: 3px;
            margin: 14px auto 0;
            border-radius: 3px;
            background: linear-gradient(
                90deg,
                #ff6b6b, #feca57, #48dbfb, #a29bfe, #ff9ff3
            );
            opacity: 0.85;
            box-shadow: 0 0 12px rgba(162, 155, 254, 0.35);
        }

        .login-card {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 480px;
            background: #2c3e50;
            border-radius: 18px;
            padding: 48px 40px;
            box-shadow:
                0 25px 60px rgba(15, 40, 25, 0.35),
                0 8px 20px rgba(15, 40, 25, 0.22);
            color: #ffffff;
            animation: cardIn 0.5s ease;
        }

        @@keyframes cardIn {
            from { opacity: 0; transform: translateY(15px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .login-card h1 {
            font-size: 22px;
            font-weight: 600;
            margin: 0 0 6px 0;
            letter-spacing: 0.3px;
        }

        .login-card .subtitle {
            font-size: 13px;
            color: #b0bccb;
            margin-bottom: 32px;
        }

        .form-label {
            font-size: 13.5px;
            font-weight: 500;
            color: #d5dde6;
            margin-bottom: 8px;
            letter-spacing: 0.2px;
        }

        .form-control {
            background: #ffffff;
            border: 1px solid #e4e9ef;
            border-radius: 8px;
            padding: 12px 14px;
            font-size: 14.5px;
            color: #2c3e50;
            transition: all 0.2s ease;
            height: auto;
        }

        .form-control::placeholder { color: #a7b3c0; font-size: 13.5px; }

        .form-control:focus {
            border-color: #4A90E2;
            box-shadow: 0 0 0 3px rgba(74, 144, 226, 0.25);
            outline: none;
        }

        .btn-proceed {
            width: 100%;
            background: #4A90E2;
            border: none;
            border-radius: 8px;
            padding: 13px;
            font-size: 14.5px;
            font-weight: 600;
            letter-spacing: 0.3px;
            color: #ffffff;
            margin-top: 16px;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .btn-proceed:hover {
            background: #3a7bc8;
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(74, 144, 226, 0.35);
        }

        .btn-proceed:active { transform: translateY(0); }

        .validation-summary {
            background: rgba(255, 107, 107, 0.12);
            border: 1px solid rgba(255, 107, 107, 0.35);
            border-radius: 8px;
            padding: 10px 14px;
            color: #ffb3b3;
            font-size: 13px;
            margin-bottom: 18px;
            list-style: none;
        }

        .validation-summary ul { margin: 0; padding-left: 18px; }


        .demo-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }

        .demo-item {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 8px;
            padding: 8px 10px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .demo-item:hover {
            background: rgba(74, 144, 226, 0.15);
            border-color: rgba(74, 144, 226, 0.4);
        }

        .demo-item .role {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.4px;
            display: block;
            margin-bottom: 2px;
        }

        .demo-item .creds {
            font-size: 10.5px;
            color: #8d9bab;
            display: block;
        }

        .role-super { color: #ff7676; }
        .role-admin { color: #ffb85c; }
        .role-user  { color: #6ec1ff; }

        /* ---------- RESPONSIVE ---------- */
        @@media (max-width: 768px) {
            .login-card {
                padding: 36px 28px;
                border-radius: 16px;
                max-width: 420px;
            }
            .login-card h1 { font-size: 20px; }
            .login-card .subtitle { margin-bottom: 26px; }

            /* Hide extra icons on tablet */
            .ic-9, .ic-10, .ic-11, .ic-12 { display: none; }
        }

        @@media (max-width: 480px) {
            .login-wrapper { padding: 16px 12px; align-items: center; }
            .login-card { padding: 32px 22px; border-radius: 14px; }
            .login-card h1 { font-size: 19px; }
            .login-card .subtitle { font-size: 12.5px; }
            .form-control { padding: 11px 12px; font-size: 14px; }
            .btn-proceed { padding: 12px; font-size: 14px; }

            /* Only 2 icons on mobile */
            .map-icon { display: none; }
            .ic-3 { display: block; top: 8%; left: 8%; font-size: 22px; }
            .ic-7 { display: block; bottom: 10%; right: 8%; font-size: 22px; }

            .demo-grid { grid-template-columns: 1fr; gap: 6px; }
        }

        @@media (max-height: 600px) {
            .login-card { padding: 24px 22px; }
            .login-card h1 { font-size: 18px; margin-bottom: 4px; }
            .login-card .subtitle { margin-bottom: 16px; }
        }
    </style>
</head>
<body>
    <div class="login-wrapper">

        <!-- ============ MAP BACKGROUND SVG ============ -->
        <div class="map-bg">
            <svg viewBox="0 0 1920 1080" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
                <!-- Green park zones -->
                <ellipse cx="300" cy="200" rx="380" ry="240" fill="#c9e6bd" opacity="0.55"/>
                <ellipse cx="1650" cy="220" rx="360" ry="230" fill="#c9e6bd" opacity="0.5"/>
                <ellipse cx="220" cy="880" rx="400" ry="260" fill="#c9e6bd" opacity="0.5"/>
                <ellipse cx="1700" cy="900" rx="380" ry="250" fill="#c9e6bd" opacity="0.55"/>
                <ellipse cx="960" cy="120" rx="500" ry="180" fill="#c9e6bd" opacity="0.35"/>
                <ellipse cx="960" cy="1000" rx="560" ry="200" fill="#c9e6bd" opacity="0.35"/>

                <!-- Subtle terrain patches -->
                <path d="M 0,400 Q 300,360 600,420 T 1200,400 T 1920,440 L 1920,520 Q 1500,560 1200,520 T 600,540 T 0,500 Z"
                      fill="#bcddaa" opacity="0.35"/>
                <path d="M 0,650 Q 400,620 800,680 T 1920,640 L 1920,720 Q 1500,760 1100,720 T 400,750 T 0,730 Z"
                      fill="#bcddaa" opacity="0.35"/>

               <!-- MAIN ROADS -->
                <g stroke="#b8bec4" stroke-linecap="round" fill="none" opacity="0.9">
                    <path d="M -100,300 L 2000,120" stroke-width="70"/>
                    <path d="M -100,720 L 2000,900" stroke-width="60"/>
                    <path d="M 300,-100 L 700,1200"  stroke-width="55"/>
                    <path d="M 1200,-100 L 900,1200" stroke-width="55"/>
                    <path d="M 1700,-100 L 1500,1200" stroke-width="50"/>
                    <path d="M -100,520 L 2000,440"  stroke-width="40"/>
                    <path d="M 500,-100 L 1400,1200" stroke-width="35"/>
                </g>

                <!-- Secondary roads -->
                <g stroke="#ffffff" stroke-linecap="round" fill="none" opacity="0.75">
                    <path d="M -100,150 L 2000,50"   stroke-width="18"/>
                    <path d="M -100,880 L 2000,1000" stroke-width="18"/>
                    <path d="M 150,-100 L 350,1200"  stroke-width="16"/>
                    <path d="M 900,-100 L 1000,1200" stroke-width="16"/>
                    <path d="M 1550,-100 L 1600,1200" stroke-width="16"/>
                </g>

                <!-- Intersection circles -->
                <g fill="#c2dfb1" opacity="0.55">
                    <circle cx="700" cy="500" r="60"/>
                    <circle cx="1300" cy="620" r="55"/>
                    <circle cx="450" cy="850" r="50"/>
                    <circle cx="1500" cy="300" r="50"/>
                </g>

                <!-- ============ TREES ALONG ROADS ============ -->
                <!-- Each tree = brown trunk (rect) + 2 green circles -->
                <defs>
                    <g id="tree">
                        <rect x="-2" y="0" width="4" height="8" fill="#7a5a3a" rx="1"/>
                        <circle cx="0" cy="-3" r="9" fill="#5fa34a"/>
                        <circle cx="-4" cy="1" r="7" fill="#6cb457"/>
                        <circle cx="4"  cy="1" r="7" fill="#6cb457"/>
                        <circle cx="0"  cy="-7" r="6" fill="#78c163" opacity="0.9"/>
                    </g>
                    <g id="bush">
                        <circle cx="0" cy="0" r="5" fill="#77bd60"/>
                        <circle cx="-3" cy="1" r="4" fill="#68ab52"/>
                        <circle cx="3"  cy="1" r="4" fill="#68ab52"/>
                    </g>
                </defs>

                
                <use href="#tree" x="120" y="270" transform="scale(1.1)"/>
                <use href="#tree" x="280" y="245"/>
                <use href="#tree" x="440" y="220" transform="scale(0.9)"/>
                <use href="#tree" x="600" y="195"/>
            
                <use href="#tree" x="1240" y="108"/>
                <use href="#tree" x="1400" y="90" transform="scale(1.1)"/>
                <use href="#tree" x="1560" y="70"/>
                <use href="#tree" x="1720" y="50" transform="scale(0.9)"/>

                <!-- Trees along bottom road -->
                <use href="#tree" x="180" y="680" transform="scale(1.05)"/>
                <use href="#tree" x="380" y="715"/>
            
                <use href="#tree" x="1460" y="880" transform="scale(1.1)"/>
                <use href="#tree" x="1680" y="910"/>
                <use href="#tree" x="1860" y="940" transform="scale(0.9)"/>

                

                <!-- Trees along vertical road 2 -->
                <use href="#tree" x="1180" y="120" transform="scale(0.9)"/>
                <use href="#tree" x="1120" y="320"/>
                <use href="#tree" x="1050" y="520" transform="scale(1.1)"/>
                <use href="#tree" x="990" y="700"/>
                <use href="#tree" x="940" y="900" transform="scale(0.9)"/>

                <!-- Bushes scattered in green areas -->
                <use href="#bush" x="200" y="150"/>
                <use href="#bush" x="340" y="200"/>
                <use href="#bush" x="180" y="240"/>
                <use href="#bush" x="1560" y="180"/>
                <use href="#bush" x="1700" y="240"/>
                <use href="#bush" x="1620" y="120"/>
                <use href="#bush" x="240" y="820"/>
                <use href="#bush" x="380" y="900"/>
                <use href="#bush" x="1600" y="880"/>
                <use href="#bush" x="1740" y="950"/>
                <use href="#bush" x="800" y="60"/>
                <use href="#bush" x="1100" y="80"/>
            </svg>
        </div>

        <!-- ============ FLOATING ICONS ============ -->

        <!-- Top-left: truck + person walking -->
        <i class="bi bi-truck map-icon ic-truck ic-1"></i>
        <i class="bi bi-person-walking map-icon ic-person ic-2"></i>

        <!-- Bottom-left: person working at desk + laptop -->
        <i class="bi bi-person-workspace map-icon ic-work ic-3"></i>
        <i class="bi bi-laptop map-icon ic-laptop ic-4"></i>

        <!-- Top-right: geo pin + person with badge -->
        <i class="bi bi-geo-alt-fill map-icon ic-pin ic-5"></i>
        <i class="bi bi-person-badge map-icon ic-person ic-6"></i>

        <!-- Bottom-right: delivery truck + package -->
        <i class="bi bi-truck map-icon ic-truck ic-7"></i>
        <i class="bi bi-box-seam map-icon ic-package ic-8"></i>

        <!-- Mid-left/right extra elements -->
        <i class="bi bi-pc-display map-icon ic-laptop ic-9"></i>
        <i class="bi bi-phone map-icon ic-phone ic-10"></i>
        <i class="bi bi-person-walking map-icon ic-person ic-11"></i>
        <i class="bi bi-geo-alt-fill map-icon ic-pin ic-12"></i>

        <!-- ============ LOGIN CARD ============ -->
        <div class="login-card">
           <div class="brand-header">
    <h1 class="brand-title">
        <span class="brand-text">Multiverse</span>
        <span class="brand-infinity">∞</span>
    </h1>
    <div class="brand-divider"></div>
</div>
            <form asp-action="Login" asp-antiforgery="true" method="post" id="loginForm">
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="validation-summary">
                        <ul>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="UsernameOrEmail" class="form-label">Email</label>
                    <input asp-for="UsernameOrEmail"
                           class="form-control"
                           placeholder="Enter here"
                           autocomplete="username"
                           id="usernameInput" />
                </div>

                <div class="mb-2">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password"
                           class="form-control"
                           placeholder="Enter here"
                           autocomplete="current-password"
                           id="passwordInput" />
                </div>

                <button type="submit" class="btn-proceed">Proceed</button>
            </form>

        </div>
    </div>

    <script>
        function fillLogin(username, password) {
            document.getElementById('usernameInput').value = username;
            document.getElementById('passwordInput').value = password;
            document.getElementById('passwordInput').focus();
        }
    </script>
</body>
</html>