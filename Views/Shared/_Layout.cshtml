@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    Func<string, string, bool> isActive = (c, a) =>
        string.Equals(currentController, c, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(currentAction, a, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - Multiverse</title>
    <script type="importmap"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ERPDemo.styles.css" asp-append-version="true" />

    <style>
        /* Design tokens shared with the login and dashboard pages.
           Kept here (not in the scoped .css) so page views can use them too. */
        :root {
            --c-coral: #ff6b6b;
            --c-amber: #feca57;
            --c-sky: #48dbfb;
            --c-violet: #a29bfe;
            --c-pink: #ff9ff3;

            --navy-900: #080d1c;
            --navy-800: #0d1530;
            --page: #f4f6fb;
            --card: #ffffff;
            --line: #e3e8f0;

            --ink: #0f172a;
            --ink-soft: #475569;
            --ink-mute: #8492a6;

            --primary: #4A90E2;
            --primary-deep: #3b6fe0;

            --font: 'Plus Jakarta Sans', 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
        }

        html { position: relative; min-height: 100%; }

        body {
            margin-bottom: 0; /* cancels the default 60px footer gap from site.css */
            font-family: var(--font);
            color: var(--ink);
            background: var(--page);
            -webkit-font-smoothing: antialiased;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark site-nav">
            <div class="container">
                <a class="navbar-brand brand-link" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Multiverse home">
                    <span class="brand-title">
                        <span class="brand-text">Multiverse</span>
                        <span class="brand-infinity">&infin;</span>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-sm-4">
                        <li class="nav-item">
                            <a class="nav-link @(isActive("Home", "Index") ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isActive("Home", "Privacy") ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
        <div class="nav-accent"></div>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="py-4">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container footer-inner">
            <span>&copy; @DateTime.Now.Year Multiverse. All rights reserved.</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
