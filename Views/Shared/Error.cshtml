@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

@*
    Developer note (hidden from users):
    To see detailed exception information, run the app in the Development environment by setting
    ASPNETCORE_ENVIRONMENT=Development and restarting. Do not enable Development on deployed apps,
    because it can expose sensitive information from exceptions to end users.
*@

@section Styles {
    <style>
        .error-wrap {
            display: flex;
            justify-content: center;
            padding: 24px 0 16px;
        }

        .error-card {
            width: 100%;
            max-width: 520px;
            padding: 44px 36px 36px;
            text-align: center;
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 20px;
            box-shadow:
                0 1px 2px rgba(15, 23, 42, 0.04),
                0 24px 48px -12px rgba(15, 23, 42, 0.14);
        }

        .error-icon {
            display: grid;
            place-items: center;
            width: 64px;
            height: 64px;
            margin: 0 auto 20px;
            border-radius: 20px;
            font-size: 28px;
            color: #d1303c;
            background: #ffecee;
        }

        .error-card h1 {
            margin: 0 0 10px;
            font-size: 26px;
            font-weight: 700;
            letter-spacing: -0.5px;
            color: var(--ink);
        }

        .error-card p {
            max-width: 380px;
            margin: 0 auto;
            font-size: 14.5px;
            line-height: 1.6;
            color: var(--ink-soft);
        }

        .request-id {
            display: inline-flex;
            align-items: center;
            flex-wrap: wrap;
            justify-content: center;
            gap: 8px;
            max-width: 100%;
            margin-top: 22px;
            padding: 8px 14px;
            font-size: 12.5px;
            color: var(--ink-soft);
            background: #f8fafd;
            border: 1px solid var(--line);
            border-radius: 10px;
        }

        .request-id code {
            font-size: 12.5px;
            color: var(--ink);
            word-break: break-all;
        }

        .error-accent {
            width: 60px;
            height: 3px;
            margin: 26px auto 24px;
            border-radius: 3px;
            background: linear-gradient(90deg, #ff6b6b, #feca57, #48dbfb, #a29bfe, #ff9ff3);
            opacity: 0.85;
        }

        .error-actions {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .btn-brand,
        .btn-ghost {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            height: 46px;
            padding: 0 22px;
            border-radius: 12px;
            font-family: var(--font);
            font-size: 14.5px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: transform 0.15s ease, box-shadow 0.2s ease, background 0.2s ease;
        }

        .btn-brand {
            color: #fff;
            border: 0;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-deep) 100%);
            box-shadow: 0 10px 22px -8px rgba(74, 144, 226, 0.4);
        }

        .btn-brand:hover { color: #fff; transform: translateY(-1px); box-shadow: 0 14px 28px -8px rgba(74, 144, 226, 0.45); }

        .btn-ghost {
            color: var(--ink);
            background: #fff;
            border: 1px solid var(--line);
        }

        .btn-ghost:hover { background: #f4f6fb; }

        .btn-brand:focus-visible,
        .btn-ghost:focus-visible {
            outline: 3px solid rgba(74, 144, 226, 0.5);
            outline-offset: 2px;
        }

        @@media (max-width: 480px) {
            .error-card { padding: 32px 22px 26px; border-radius: 18px; }
            .error-card h1 { font-size: 22px; }
            .error-actions { flex-direction: column; }
            .btn-brand, .btn-ghost { width: 100%; }
        }

        @@media (prefers-reduced-motion: reduce) {
            .btn-brand, .btn-ghost { transition: none; }
        }
    </style>
}

<div class="error-wrap">
    <div class="error-card">
        <div class="error-icon"><i class="bi bi-exclamation-triangle"></i></div>

        <h1>Something went wrong</h1>
        <p>An error occurred while processing your request. Please try again, or head back to the home page.</p>

        @if (Model.ShowRequestId)
        {
            <div class="request-id">
                <strong>Request ID</strong>
                <code>@Model.RequestId</code>
            </div>
        }

        <div class="error-accent"></div>

        <div class="error-actions">
            <a class="btn-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house"></i>Go to home
            </a>
            <button type="button" class="btn-ghost" onclick="history.back()">
                <i class="bi bi-arrow-left"></i>Go back
            </button>
        </div>
    </div>
</div>
